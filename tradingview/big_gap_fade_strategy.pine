//@version=6
strategy("Big Gap Fade BACKTEST (TradeLogger)", shorttitle = "TL Gap BT", overlay = true, initial_capital = 6000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0, process_orders_on_close = true, calc_on_every_tick = false, dynamic_requests = true, margin_long = 0, margin_short = 0, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// =============================================================================
// THE BACKTEST VERSION of big_gap_fade.pine (that one is an indicator; TradingView's Strategy Tester
// only works on a strategy). Same rule, placed as real orders so you get the Strategy Tester's trade list,
// equity curve, win rate and drawdown:
//   GAP     today's 09:30 open vs yesterday's 16:00 close. A setup = a gap of at least the first input x the
//           average daily range of the last 14 sessions (0.2 = learning mode, 0.7 = the research threshold).
//   ENTRY   default = a STRUCTURE SHIFT (MSS): the session extreme, then a close beyond the pullback level that launched it
//           (09:35-11:00 New York, no fixed time; no shift = no trade; read from 1-minute data even on a 5- or 15-minute chart). Option: the old fixed 09:45 entry. Always TOWARD
//           yesterday's close (gap up = short, gap down = long), only while the gap is still unfilled.
//   STOP    your choice (wide / structure / medium / fixed / tight).  TARGET  yesterday's close or the nearest
//           5-minute swing; default = half at +1R, stop to breakeven, rest at yesterday's close.
//   EXIT    target, stop or breakeven. NO time rule by default (optional: close at a set time).
// Use a 1-, 5- or 15-minute chart (the entry time must fall on a bar boundary).
// SET COSTS in the Properties tab (slippage in ticks, commission): the defaults are zero, so a result here is
// BEFORE costs. Research result: no confirmed edge (about +0.00 to +0.05R per trade); this is a way to LOOK at it.
// How far back it can test depends on your TradingView plan and the data on this symbol.
// Half-off options: half at the nearest 5-minute swing or at +1R, then the stop moves to breakeven for the rest.
// MARGIN IS TURNED OFF (margin_long/margin_short = 0): one NAS100 / US30 contract is worth $30,000+, far more than a
// small account holds, and with TradingView's default 100% margin it silently refuses every order ("requires trade data").
// Risk is still capped by the stop and the Risk % input; this only stops the tester from rejecting the order.
// =============================================================================

NY = "America/New_York"

grpG = "Gap"
thr = input.float(0.2, "Take a setup when the gap is at least x the average daily range", minval = 0.1, step = 0.1, group = grpG, tooltip = "0.2 = learning mode (about 3 setups a week per index). 0.7 = the research threshold (about 1 a week).")
rangeDays = input.int(14, "Average range over the last N sessions", minval = 5, group = grpG)

grpT = "Trade"
entryMethod = input.string("Structure shift (MSS): enter at the break candle's close", "Entry method", options = ["Structure shift (MSS): enter at the break candle's close", "Structure shift (MSS): wait for a pullback to the 50% level", "Fixed time (the 'Enter at' time below)"], group = grpT, tooltip = "MSS = no fixed time: on a gap day wait for the session extreme (the extension), then for a candle to CLOSE beyond the pullback level that launched it (the market-structure shift), between 09:35 and 11:00 New York. No shift = no trade. Break enters at the close of the CHART bar that contains the 1-minute break (the structure is read from 1-minute data on any chart timeframe). Retest waits for price to pull back to the 50% level of the move (in this tester it fills at the close of the first bar that reaches it, a little later than a true limit order). Fixed time is the old rule.")
entryAt = input.string("0945", "Enter at (New York time; fixed-time method only)", options = ["0935", "0940", "0945", "0950", "1000", "1015", "1030"], group = grpT)
exitAt = input.string("Never: hold until the target, the stop or breakeven", "Close the trade at a set time (New York)", options = ["Never: hold until the target, the stop or breakeven", "1100", "1130", "1200", "1300", "1330", "1555"], group = grpT, tooltip = "Default: no time rule. The trade stays open (even overnight) until price reaches the target, the stop, or the breakeven stop after the half is taken. While a trade is open, a new setup is skipped.")
stopMode = input.string("MSS: just beyond the extension (the high/low the shift came from)", "Stop", options = ["MSS: just beyond the extension (the high/low the shift came from)", "Wide: 1:1 with the target", "Structure: beyond the nearest 1-minute swing", "Structure: beyond the nearest 5-minute swing", "Medium: 0.25 x the average daily range", "Fixed: 0.21% of price (about 64 NQ points)", "Tight: beyond the 09:30-to-entry extreme"], group = grpT, tooltip = "The MSS stop sits just beyond the extension. With the fixed-time entry it behaves like Wide.")
skipLow = input.bool(true, "MSS entries: skip when the reward is under 1R", group = grpT, tooltip = "Reward = distance to yesterday's close; 1R = the distance from the entry to the stop.")
targetMode = input.string("Ladder: a third at each of two structure levels, the last third runs past yesterday's close", "Target", options = ["Ladder: a third at each of two structure levels, the last third runs past yesterday's close", "Half at the structure near +1R, stop to breakeven, rest at yesterday's close", "Half at +1R, stop to breakeven, rest at yesterday's close", "Yesterday's close", "Nearest 5-minute swing (1R or more away)", "Half at the nearest 5-minute swing, rest at yesterday's close"], group = grpT, tooltip = "Ladder = a third at the nearest marked high/low (1m/5m swing), a third at the next one, stop to breakeven after the first and behind the first level after the second; the last third is NOT closed at yesterday's close: its stop jumps to yesterday's close and then trails behind each new 5-minute swing.")

grpR = "Position size"
riskPct = input.float(1.0, "Risk per trade (% of equity)", minval = 0.1, step = 0.1, group = grpR, tooltip = "Quantity = equity x this % / (stop distance x point value). A wide stop means a small position.")
minQty = input.float(0.01, "Smallest quantity allowed", minval = 0.0001, step = 0.01, group = grpR, tooltip = "Never trades less than the symbol's smallest step (often 1 contract). If one contract risks more than your risk %, it trades one contract anyway, so the real risk is shown in each trade's comment.")

grpD = "Display"
showBoxes = input.bool(true, "Draw the target / stop boxes", group = grpD)
showStructure = input.bool(true, "Draw the extension and the break level (MSS entries)", group = grpD)

minSess = 5
minRiskAtr = 0.10

// ---------------------------------------------------------------- session flags
inRTH = not na(time(timeframe.period, "0930-1600", NY))
rthStart = inRTH and not inRTH[1]
closeMin = hour(time_close, NY) * 60 + minute(time_close, NY)
entryMin = int(str.tonumber(str.substring(entryAt, 0, 2))) * 60 + int(str.tonumber(str.substring(entryAt, 2, 4)))
noTimeExit = exitAt == "Never: hold until the target, the stop or breakeven"
mssMode = entryMethod != "Fixed time (the 'Enter at' time below)"
retestMode = entryMethod == "Structure shift (MSS): wait for a pullback to the 50% level"
ladderMode = targetMode == "Ladder: a third at each of two structure levels, the last third runs past yesterday's close"
exitMin = noTimeExit ? 99999 : int(str.tonumber(str.substring(exitAt, 0, 2))) * 60 + int(str.tonumber(str.substring(exitAt, 2, 4)))

// ---------------------------------------------------------------- state
var float rthHi = na
var float rthLo = na
var float lastClose = na
var float prevClose = na
var float[] ranges = array.new_float()
var float avgRange = na
var float gap = na
var float gapSize = na
var bool dayBig = false
var bool gapUp = false
var bool touched = false
var float preHi = na
var float preLo = na
var int state = 0 // 0 = no setup today, 1 = waiting for the entry (time or structure shift), 2 = trade open, 3 = finished / skipped, 4 = result label pending, 5 = waiting for the retest
var int entryIdx = 0
var float stopPx = na
var float tgtPx = na
var float riskPts = na
var float entryPx = na
var float tp1Px = na
var float initQty = na
var bool beMoved = false
var int tradesAtEntry = 0
var float riskUsdT = na
var string howT = ""
var float lvl1 = na
var float lvl2 = na
var float curStop = na
var bool pcHit = false
var line ln1 = na
var line ln2 = na
// swings since the open (A = latest, B = the one before) and the extension / break level for the MSS entry
var float lowA = na
var float lowB = na
var int lowAidx = na
var float highA = na
var float highB = na
var int highAidx = na
var float extLvl = na
var int extBar = na
var int extIdx = na
var int subIdx = 0
var float runHi1 = na
var float runLo1 = na
var float pO1 = na
var float pC1 = na
var float pH1 = na
var float pL1 = na
var float launch = na
var float legExt = na
var float retLvl = na
var int brkBar = na
var line retLine = na
var box bTgt = na
var box bRisk = na

// ---------------------------------------------------------------- internal structure (1- and 5-minute swings)
// A swing high = a bullish candle followed by a bearish one (price = the higher of the two highs); a swing low is the mirror.
swingData() =>
    bool sh = close[1] > open[1] and close < open
    bool sl = close[1] < open[1] and close > open
    float hp = math.max(high[1], high)
    float lp = math.min(low[1], low)
    [ta.valuewhen(sh, hp, 0), ta.valuewhen(sh, hp, 1), ta.valuewhen(sh, hp, 2), ta.valuewhen(sl, lp, 0), ta.valuewhen(sl, lp, 1), ta.valuewhen(sl, lp, 2)]

// as of the close of the bar that ends at the entry time, which is when the order is placed
[s1h0, s1h1, s1h2, s1l0, s1l1, s1l2] = request.security(syminfo.tickerid, "1", swingData())
[s5h0, s5h1, s5h2, s5l0, s5l1, s5l2] = request.security(syminfo.tickerid, "5", swingData())

nearAbove(float x1, float x2, float x3, float ref, float minGap) =>
    float best = na
    if not na(x1) and x1 > ref + minGap
        best := x1
    if not na(x2) and x2 > ref + minGap
        best := na(best) ? x2 : math.min(best, x2)
    if not na(x3) and x3 > ref + minGap
        best := na(best) ? x3 : math.min(best, x3)
    best

nearBelow(float x1, float x2, float x3, float ref, float minGap) =>
    float best = na
    if not na(x1) and x1 < ref - minGap
        best := x1
    if not na(x2) and x2 < ref - minGap
        best := na(best) ? x2 : math.max(best, x2)
    if not na(x3) and x3 < ref - minGap
        best := na(best) ? x3 : math.max(best, x3)
    best

// stop distance in points (ep = entry price, dist = distance to yesterday's close, far = the 09:30-to-entry extreme on the far side, up = the stop sits ABOVE the entry, i.e. a short)
calcRisk(float ep, float dist, float far, bool up) =>
    float r = na
    if stopMode == "MSS: just beyond the extension (the high/low the shift came from)"
        r := (na(extLvl) or (up ? extLvl <= ep : extLvl >= ep)) ? dist : math.max(math.abs(extLvl - ep) + 2 * syminfo.mintick, 0.05 * avgRange)
    else if stopMode == "Wide: 1:1 with the target"
        r := dist
    else if stopMode == "Medium: 0.25 x the average daily range"
        r := 0.25 * avgRange
    else if stopMode == "Fixed: 0.21% of price (about 64 NQ points)"
        r := 0.0021 * ep
    else if stopMode == "Tight: beyond the 09:30-to-entry extreme"
        r := math.max(math.abs(far - ep), minRiskAtr * avgRange)
    else
        bool oneMin = stopMode == "Structure: beyond the nearest 1-minute swing"
        float sw = up ? (oneMin ? nearAbove(s1h0, s1h1, s1h2, ep, 0.05 * avgRange) : nearAbove(s5h0, s5h1, s5h2, ep, 0.05 * avgRange)) : (oneMin ? nearBelow(s1l0, s1l1, s1l2, ep, 0.05 * avgRange) : nearBelow(s5l0, s5l1, s5l2, ep, 0.05 * avgRange))
        r := na(sw) ? dist : math.abs(sw - ep) + 2 * syminfo.mintick
    r

calcTarget(float ep, float risk, bool shortTrade) =>
    float tgt = prevClose
    if targetMode == "Nearest 5-minute swing (1R or more away)"
        float sw = shortTrade ? nearBelow(s5l0, s5l1, s5l2, ep, risk) : nearAbove(s5h0, s5h1, s5h2, ep, risk)
        tgt := na(sw) ? prevClose : sw
    tgt

// the half-off level taken from the chart: the 1- or 5-minute swing in the profit direction that sits closest to +1R,
// but only between 0.7R and 1.5R away; if there is none, exactly +1R
nearOneR(float ep, float risk, bool shortTrade) =>
    float one = shortTrade ? ep - risk : ep + risk
    float best = na
    float[] cand = shortTrade ? array.from(s1l0, s1l1, s1l2, s5l0, s5l1, s5l2) : array.from(s1h0, s1h1, s1h2, s5h0, s5h1, s5h2)
    for i = 0 to 5
        float x = array.get(cand, i)
        if not na(x)
            float d = shortTrade ? ep - x : x - ep
            if d >= 0.7 * risk and d <= 1.5 * risk and (na(best) or math.abs(x - one) < math.abs(best - one))
                best := x
    na(best) ? one : best

// the ladder: the two nearest marked highs (long) / lows (short) between 0.5R and yesterday's close, the second at least 0.5R beyond the first;
// missing ones fall back to +1R / +2R (only if closer than yesterday's close). Returns the two PRICES (na = none).
ladderLevels(float ep, float risk, bool shortTrade, float tdist) =>
    float lim = tdist * 0.999
    float[] cand = shortTrade ? array.from(s1l0, s1l1, s1l2, s5l0, s5l1, s5l2) : array.from(s1h0, s1h1, s1h2, s5h0, s5h1, s5h2)
    float d1 = na
    for i = 0 to 5
        float x = array.get(cand, i)
        if not na(x)
            float d = shortTrade ? ep - x : x - ep
            if d >= 0.5 * risk and d < lim and (na(d1) or d < d1)
                d1 := d
    float d2 = na
    if not na(d1)
        for i = 0 to 5
            float x = array.get(cand, i)
            if not na(x)
                float d = shortTrade ? ep - x : x - ep
                if d >= d1 + 0.5 * risk and d < lim and (na(d2) or d < d2)
                    d2 := d
    else if risk < lim
        d1 := risk
    if not na(d1) and na(d2)
        d2 := math.max(2 * risk, d1 + 0.5 * risk)
        if d2 >= lim
            d2 := 0.5 * (d1 + tdist)
    [na(d1) ? na : (shortTrade ? ep - d1 : ep + d1), na(d2) ? na : (shortTrade ? ep - d2 : ep + d2)]

// optional half-off level
calcHalf(float ep, float risk, bool shortTrade) =>
    float tp1 = na
    if targetMode == "Half at the structure near +1R, stop to breakeven, rest at yesterday's close"
        tp1 := nearOneR(ep, risk, shortTrade)
    else if targetMode == "Half at +1R, stop to breakeven, rest at yesterday's close"
        tp1 := shortTrade ? ep - risk : ep + risk
    else if targetMode == "Half at the nearest 5-minute swing, rest at yesterday's close"
        tp1 := shortTrade ? nearBelow(s5l0, s5l1, s5l2, ep, 0.5 * risk) : nearAbove(s5h0, s5h1, s5h2, ep, 0.5 * risk)
    tp1

// the result of the trade that just ended, written on the chart where it ended: WIN / LOSS / SCRATCH, in R and in dollars
showResult(int atBar, string how) =>
    if strategy.closedtrades > tradesAtEntry
        float pnl = 0.0
        for i = tradesAtEntry to strategy.closedtrades - 1
            pnl += strategy.closedtrades.profit(i)
        float res = (na(riskUsdT) or riskUsdT == 0) ? 0.0 : pnl / riskUsdT
        float xp = strategy.closedtrades.exit_price(strategy.closedtrades - 1)
        string h = how
        if h == ""
            float tol = 2 * syminfo.mintick
            h := math.abs(xp - tgtPx) <= tol ? "hit the target" : math.abs(xp - stopPx) <= tol ? "stopped out" : math.abs(xp - entryPx) <= tol ? "back to breakeven after taking half" : (ladderMode ? "trailing stop hit" : "closed")
        string cls = res >= 0.15 ? "WIN" : res <= -0.15 ? "LOSS" : "SCRATCH"
        color col = res >= 0.15 ? color.new(color.green, 15) : res <= -0.15 ? color.new(color.red, 15) : color.new(color.gray, 15)
        label.new(atBar, xp, cls + " " + (res >= 0 ? "+" : "") + str.tostring(res, "0.00") + "R  (" + (pnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(pnl), "0") + ")  " + h, style = label.style_label_left, color = col, textcolor = color.white, size = size.normal)

// a trade closed at the last bar's close is only counted by TradingView on the next bar, so its label is written then
if state == 4
    showResult(bar_index - 1, howT)
    state := 3

// ---------------------------------------------------------------- the day
if rthStart
    dayBig := false
    prevClose := lastClose
    if not na(rthHi)
        array.push(ranges, rthHi - rthLo)
        if array.size(ranges) > rangeDays
            array.shift(ranges)
    avgRange := array.size(ranges) >= minSess ? array.avg(ranges) : na
    rthHi := high
    rthLo := low
    gap := open - prevClose
    gapSize := (na(avgRange) or na(prevClose)) ? na : math.abs(gap) / avgRange
    dayBig := not na(gapSize) and gapSize >= thr
    gapUp := gap > 0
    touched := false
    preHi := high
    preLo := low
    lowA := na
    lowB := na
    lowAidx := na
    highA := na
    highB := na
    highAidx := na
    extIdx := na
    subIdx := 0
    runHi1 := na
    runLo1 := na
    pO1 := na
    pC1 := na
    pH1 := na
    pL1 := na
    extLvl := na
    extBar := na
    launch := na
    legExt := na
    state := state == 2 ? 2 : (dayBig ? 1 : 0) // a trade still open from an earlier day keeps being managed
else if inRTH
    rthHi := math.max(rthHi, high)
    rthLo := math.min(rthLo, low)
if inRTH
    lastClose := close

// ---------------------------------------------------------------- the 1-minute bars inside this chart bar
// The structure is read from 1-minute data whatever the chart timeframe (a 5-minute chart would otherwise see far fewer shifts).
bool lowerOK = timeframe.in_seconds(timeframe.period) > 60
float[] m1o = array.new_float()
float[] m1h = array.new_float()
float[] m1l = array.new_float()
float[] m1c = array.new_float()
if mssMode
    if lowerOK
        m1o := request.security_lower_tf(syminfo.tickerid, "1", open)
        m1h := request.security_lower_tf(syminfo.tickerid, "1", high)
        m1l := request.security_lower_tf(syminfo.tickerid, "1", low)
        m1c := request.security_lower_tf(syminfo.tickerid, "1", close)
    else
        array.push(m1o, open)
        array.push(m1h, high)
        array.push(m1l, low)
        array.push(m1c, close)

// ---------------------------------------------------------------- finding the entry
bool doEnter = false
float eIn = na
float eE = na
float rpE = na

// (a) fixed time: has the gap filled? then, on the bar that closes at the entry time, place the trade
if state == 1 and inRTH and not mssMode and closeMin <= entryMin
    if gapUp ? low <= prevClose : high >= prevClose
        touched := true
    if rthStart
        preHi := high
        preLo := low
    else
        preHi := math.max(preHi, high)
        preLo := math.min(preLo, low)
    if closeMin == entryMin
        bool okSide = gapUp ? close > prevClose : close < prevClose
        if not touched and okSide
            doEnter := true
            eIn := close
        else
            state := 3

// (b) structure shift, read bar by bar from the 1-minute data: the extension, then a close beyond the pullback level that launched it
if state == 1 and inRTH and mssMode and array.size(m1h) > 0
    int n = array.size(m1h)
    for j = 0 to n - 1
        if state != 1
            break
        float o1 = array.get(m1o, j)
        float h1 = array.get(m1h, j)
        float l1 = array.get(m1l, j)
        float c1 = array.get(m1c, j)
        bool first1 = na(pO1)
        float rhPrev1 = runHi1
        float rlPrev1 = runLo1
        runHi1 := na(runHi1) ? h1 : math.max(runHi1, h1)
        runLo1 := na(runLo1) ? l1 : math.min(runLo1, l1)
        bool sh1 = not first1 and pC1 > pO1 and c1 < o1
        bool sl1 = not first1 and pC1 < pO1 and c1 > o1
        float shL = math.max(nz(pH1), h1)
        float slL = math.min(nz(pL1, 1.0e12), l1)
        int subEnd = closeMin - (n - 1 - j)
        bool brk = false
        if gapUp ? l1 <= prevClose : h1 >= prevClose
            state := 3
        else if subEnd > 660
            state := 3
        else
            if not na(extLvl) and (gapUp ? runHi1 > extLvl : runLo1 < extLvl)
                extLvl := na
            if not na(extLvl) and subIdx > extIdx
                legExt := gapUp ? math.min(legExt, l1) : math.max(legExt, h1)
            if not na(extLvl) and not first1 and subEnd >= 575 and subIdx > extIdx
                brk := gapUp ? (c1 < launch and c1 > prevClose) : (c1 > launch and c1 < prevClose)
            if brk
                if showStructure
                    line.new(extBar - 1, extLvl, bar_index, extLvl, color = color.new(color.orange, 10), style = line.style_dotted, width = 2)
                    label.new(extBar, extLvl, gapUp ? "extension high" : "extension low", style = gapUp ? label.style_label_down : label.style_label_up, color = color.new(color.orange, 30), textcolor = color.white, size = size.tiny)
                    line.new(extBar - 3, launch, bar_index, launch, color = color.new(color.purple, 10), style = line.style_dashed, width = 2)
                    label.new(bar_index, launch, "MSS (1m): closed through " + str.tostring(launch, format.mintick), style = gapUp ? label.style_label_up : label.style_label_down, color = color.new(color.purple, 20), textcolor = color.white, size = size.small)
                if retestMode
                    retLvl := extLvl + (legExt - extLvl) * 0.5
                    brkBar := bar_index
                    state := 5
                    if showStructure
                        retLine := line.new(bar_index, retLvl, bar_index + 1, retLvl, color = color.new(color.aqua, 0), style = line.style_dashed, width = 2)
                else
                    doEnter := true
                    eIn := close
                    state := 6
            if not brk
                if gapUp and sh1 and shL >= runHi1
                    extLvl := shL
                    extBar := bar_index
                    extIdx := subIdx
                    launch := (not na(lowA) and lowAidx <= subIdx - 2) ? lowA : (not na(lowB) ? lowB : rlPrev1)
                    legExt := l1
                if (not gapUp) and sl1 and slL <= runLo1
                    extLvl := slL
                    extBar := bar_index
                    extIdx := subIdx
                    launch := (not na(highA) and highAidx <= subIdx - 2) ? highA : (not na(highB) ? highB : rhPrev1)
                    legExt := h1
        // remember this bar's swings (after the checks above used the older ones)
        if sl1
            lowB := lowA
            lowA := slL
            lowAidx := subIdx
        if sh1
            highB := highA
            highA := shL
            highAidx := subIdx
        pO1 := o1
        pC1 := c1
        pH1 := h1
        pL1 := l1
        subIdx += 1
    if state == 6
        state := 1  // handed to the placement code below

// (c) waiting for the retest of the 50% level, checked 1-minute bar by 1-minute bar from the next chart bar on
if state == 5 and bar_index > brkBar and inRTH and array.size(m1h) > 0
    int n5 = array.size(m1h)
    bool cancel = false
    for j = 0 to n5 - 1
        float h5 = array.get(m1h, j)
        float l5 = array.get(m1l, j)
        int subEnd5 = closeMin - (n5 - 1 - j)
        if gapUp ? h5 >= extLvl : l5 <= extLvl
            cancel := true
            break
        else if gapUp ? l5 <= prevClose : h5 >= prevClose
            cancel := true
            break
        else if subEnd5 > 720
            cancel := true
            break
        else if gapUp ? h5 >= retLvl : l5 <= retLvl
            doEnter := true
            eIn := close
            break
    if cancel
        state := 3
        if not na(retLine)
            line.set_x2(retLine, bar_index)
            label.new(bar_index, retLvl, "retest cancelled", style = label.style_label_left, color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)

// (d) size it; MSS entries can be skipped when the reward to yesterday's close is under 1R
if doEnter
    eE := eIn
    rpE := calcRisk(eIn, math.abs(eIn - prevClose), mssMode ? (gapUp ? rthHi : rthLo) : (gapUp ? preHi : preLo), gapUp)
    if mssMode and skipLow and math.abs(eIn - prevClose) < rpE
        doEnter := false
        state := 3
        if not na(retLine)
            line.set_x2(retLine, bar_index)

// (e) place the trade
if doEnter
    float e = eE
    float rp = rpE
    int side = gapUp ? -1 : 1
    float tg = calcTarget(e, rp, gapUp)
    float sp = e - side * rp
    // TradingView rounds an order down to the symbol's smallest step; a fraction of a contract becomes ZERO and nothing trades.
    // So round down to the step, and never go below one step (or your own minimum).
    float step = (na(syminfo.mincontract) or syminfo.mincontract <= 0) ? 1.0 : syminfo.mincontract
    float rawQty = strategy.equity * riskPct / 100.0 / (rp * syminfo.pointvalue)
    float qty = math.max(math.floor(rawQty / step) * step, math.max(step, minQty))
    float riskUsd = qty * rp * syminfo.pointvalue
    riskPts := rp
    tgtPx := tg
    stopPx := sp
    strategy.entry("GAP", side < 0 ? strategy.short : strategy.long, qty = qty, comment = side < 0 ? "SHORT" : "LONG")
    riskUsdT := riskUsd
    tradesAtEntry := strategy.closedtrades
    float t1 = ladderMode ? na : calcHalf(e, rp, gapUp)
    lvl1 := na
    lvl2 := na
    pcHit := false
    curStop := sp
    if ladderMode
        [l1, l2] = ladderLevels(e, rp, gapUp, math.abs(e - prevClose))
        lvl1 := l1
        lvl2 := l2
        if not na(l1)
            strategy.exit("GAP L1", from_entry = "GAP", qty_percent = 33.34, stop = sp, limit = l1)
        if not na(l2)
            strategy.exit("GAP L2", from_entry = "GAP", qty_percent = 33.33, stop = sp, limit = l2)
        strategy.exit("GAP run", from_entry = "GAP", stop = sp)
        if showBoxes and not na(l1)
            ln1 := line.new(bar_index, l1, bar_index + 1, l1, color = color.new(color.aqua, 0), style = line.style_dashed, width = 2)
            label.new(bar_index, l1, "1/3 at " + str.tostring(l1, format.mintick), style = label.style_label_left, color = color.new(color.aqua, 25), textcolor = color.white, size = size.small)
        if showBoxes and not na(l2)
            ln2 := line.new(bar_index, l2, bar_index + 1, l2, color = color.new(color.aqua, 0), style = line.style_dashed, width = 2)
            label.new(bar_index, l2, "1/3 at " + str.tostring(l2, format.mintick), style = label.style_label_left, color = color.new(color.aqua, 25), textcolor = color.white, size = size.small)
    else if na(t1)
        strategy.exit("GAP exit", from_entry = "GAP", stop = sp, limit = tg)
    else
        strategy.exit("GAP half", from_entry = "GAP", qty_percent = 50, stop = sp, limit = t1)
        strategy.exit("GAP rest", from_entry = "GAP", stop = sp, limit = tg)
    entryPx := e
    tp1Px := t1
    initQty := qty
    beMoved := false
    entryIdx := bar_index
    state := 2
    if not na(retLine)
        line.set_x2(retLine, bar_index)
    if showBoxes
        bTgt := box.new(bar_index, math.max(e, tg), bar_index + 1, math.min(e, tg), border_color = color.new(color.green, 30), bgcolor = color.new(color.green, 85), text = "TARGET " + str.tostring(tg, format.mintick) + "   (+" + str.tostring(math.abs(e - tg) / rp, "0.0") + "R = +$" + str.tostring(riskUsd * math.abs(e - tg) / rp, "0") + ")", text_color = color.green, text_size = size.small, text_halign = text.align_right, text_valign = side < 0 ? text.align_bottom : text.align_top)
        bRisk := box.new(bar_index, math.max(e, sp), bar_index + 1, math.min(e, sp), border_color = color.new(color.red, 30), bgcolor = color.new(color.red, 85), text = "STOP " + str.tostring(sp, format.mintick) + "   (-1R = -$" + str.tostring(riskUsd, "0") + ")", text_color = color.red, text_size = size.small, text_halign = text.align_right, text_valign = side < 0 ? text.align_top : text.align_bottom)

// manage: the exit orders handle the stop and target; this closes at the exit time and keeps the boxes growing
if state == 2 and bar_index > entryIdx
    if showBoxes
        box.set_right(bTgt, bar_index)
        box.set_right(bRisk, bar_index)
    if showBoxes and ladderMode
        if not na(ln1)
            line.set_x2(ln1, bar_index)
        if not na(ln2)
            line.set_x2(ln2, bar_index)
    if ladderMode and strategy.position_size != 0
        float q = math.abs(strategy.position_size)
        bool d1 = not na(lvl1) and q < initQty * 0.8
        bool d2 = not na(lvl2) and q < initQty * 0.45
        if not pcHit and (gapUp ? low <= tgtPx : high >= tgtPx)
            pcHit := true
        float ns = stopPx
        if d1
            ns := entryPx
        if d2
            ns := lvl1
        if pcHit
            ns := gapUp ? math.min(ns, tgtPx) : math.max(ns, tgtPx)
            float sw = gapUp ? s5h0 : s5l0
            if not na(sw) and (gapUp ? sw < ns : sw > ns)
                ns := sw
        // the stop only ever moves in our favour; re-issue only the exits that are still open (a filled one would otherwise be placed again)
        if (gapUp ? ns < curStop : ns > curStop)
            curStop := ns
            if not na(lvl1) and not d1
                strategy.exit("GAP L1", from_entry = "GAP", qty_percent = 33.34, stop = curStop, limit = lvl1)
            if not na(lvl2) and not d2
                strategy.exit("GAP L2", from_entry = "GAP", qty_percent = 33.33, stop = curStop, limit = lvl2)
            strategy.exit("GAP run", from_entry = "GAP", stop = curStop)
    if not na(tp1Px) and not beMoved and strategy.position_size != 0 and math.abs(strategy.position_size) < initQty * 0.75
        strategy.exit("GAP rest", from_entry = "GAP", stop = entryPx, limit = tgtPx)
        beMoved := true
    if strategy.position_size == 0
        state := 3
        showResult(bar_index, "")
    else if not noTimeExit and inRTH and closeMin >= exitMin
        strategy.close("GAP", comment = "time exit")
        howT := "closed by the time rule at " + exitAt
        state := 4
    else if not noTimeExit and not inRTH
        strategy.close("GAP", comment = "end of session")
        howT := "closed at the end of the session"
        state := 4

bgcolor(dayBig and inRTH and closeMin <= exitMin ? color.new(color.blue, 96) : na)
