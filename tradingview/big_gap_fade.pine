//@version=6
indicator("Big Gap Fade (TradeLogger)", shorttitle = "TL Gap", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// =============================================================================
// ONE RULE, from docs/PHASE_116_117_CONTEXT_PARTIALS_GAPS.md and PHASE_118:
// "Fade a BIG opening gap back toward yesterday's close."
//
//   GAP     today's 09:30 open vs yesterday's 16:00 close.
//           BIG = at least 0.7 x the average daily range of the last 14 sessions.
//   ENTRY   09:45, only if the gap is still unfilled -> trade TOWARD yesterday's close
//           (gap up = SHORT, gap down = LONG).
//   TARGET  yesterday's close.   STOP  wide (1:1) or tight (beyond the 09:30-09:45 extreme).
//   EXIT    target, stop, or 12:00 - whichever comes first.
//
// Result over 3.5 years on NQ/ES/Dow/Russell: about +0.05R per trade, positive in 2025-26 on
// NQ/ES and flat in 2023-24. NOT proven. Forward-track it. Past results here are before costs.
// What you see on the chart: the SUMMARY CARD (bottom-left) tells you what to do today; on a big-gap
// day an orange line marks the target and boxes mark the target (green) and stop (red).
// Use a 1- to 15-minute chart.
// =============================================================================

NY = "America/New_York"

grpG = "Gap"
thr = input.float(0.7, "Big gap = at least x the average daily range", minval = 0.1, step = 0.1, group = grpG, tooltip = "0.7 is the threshold from the research. 0.5 gives more days and a weaker effect; 1.0 fewer days and a stronger one.")
rangeDays = input.int(14, "Average range over the last N sessions", minval = 5, group = grpG)

grpT = "Trade"
entryAt = input.string("0945", "Enter at (New York time)", options = ["0935", "0940", "0945", "0950", "1000", "1015", "1030"], group = grpT)
exitAt = input.string("1200", "Exit at (New York time)", options = ["1100", "1130", "1200", "1300", "1330", "1555"], group = grpT)
stopMode = input.string("Wide: 1:1 with the target", "Stop", options = ["Wide: 1:1 with the target", "Tight: beyond the 09:30-to-entry extreme"], group = grpT, tooltip = "Wide: as far from your entry as the target is (about 257 points on NQ, 47 on ES), so use a SMALL position. Rarely hit (5% of trades); most trades end at the time exit.\nTight: just beyond the high (gap up) or low (gap down) made since 09:30. Hit about 58% of the time, but bigger wins. More volatile; was flat before 2025.")

grpD = "Display"
showCard = input.bool(true, "Show the summary card (bottom-left)", group = grpD)
showAllGaps = input.bool(false, "Also label the small gaps on normal days (busy)", group = grpD)

minSess = 5
minRiskAtr = 0.10

// ---------------------------------------------------------------- session flags
inRTH = not na(time(timeframe.period, "0930-1600", NY))
rthStart = inRTH and not inRTH[1]
afterEntry = not na(time(timeframe.period, entryAt + "-1600", NY))
entryBar = afterEntry and not afterEntry[1]
beforeExit = not na(time(timeframe.period, "0930-" + exitAt, NY))
tfOk = timeframe.in_seconds() <= 900

// ---------------------------------------------------------------- state
var float rthHi = na
var float rthLo = na
var float lastClose = na
var float prevClose = na
var float[] ranges = array.new_float()
var float avgRange = na
var float gap = na
var float gapSize = na
var bool dayBig = false
var bool gapUp = false
var bool touched = false
var float preHi = na
var float preLo = na
var int state = 0 // 0 = no big gap today, 1 = waiting for the entry time, 2 = trade open, 3 = finished / skipped
var line pcLine = na
var int dayStartBar = 0

var float entryPx = na
var float stopPx = na
var float tgtPx = na
var float riskPts = na
var float distPts = na
var int side = 0
var box bTgt = na
var box bRisk = na
var box pTgt = na
var box pRisk = na

var int nSess = 0
var int nTr = 0
var int nWin = 0
var float rSum = 0.0

var string headline = "WARMING UP - scroll the chart left to load more history"
var color hColor = color.gray
var string detail = ""

bool newTrade = false

if rthStart
    if not na(pTgt)
        box.delete(pTgt)
        box.delete(pRisk)
        pTgt := na
        pRisk := na
    dayStartBar := bar_index
    prevClose := lastClose
    if not na(rthHi)
        array.push(ranges, rthHi - rthLo)
        if array.size(ranges) > rangeDays
            array.shift(ranges)
    avgRange := array.size(ranges) >= minSess ? array.avg(ranges) : na
    rthHi := high
    rthLo := low
    gap := open - prevClose
    gapSize := (na(avgRange) or na(prevClose)) ? na : math.abs(gap) / avgRange
    dayBig := not na(gapSize) and gapSize >= thr
    gapUp := gap > 0
    touched := false
    preHi := high
    preLo := low
    nSess += 1
    state := dayBig ? 1 : 0
    pcLine := na
    detail := ""
    if dayBig
        pcLine := line.new(bar_index, prevClose, bar_index, prevClose, color = color.new(color.orange, 0), style = line.style_dashed, width = 2)
        label.new(bar_index, high, "BIG GAP " + str.tostring(gapSize, "0.00") + "x", style = label.style_label_down, color = color.new(color.orange, 10), textcolor = color.white, size = size.normal, tooltip = "Gap = 09:30 open minus yesterday's 16:00 close = " + str.tostring(gap, format.mintick) + " points, " + str.tostring(gapSize, "0.00") + "x the normal daily range. Big = " + str.tostring(thr, "0.0") + "x or more.")
        headline := "BIG GAP - plan: " + (gapUp ? "SHORT" : "LONG") + " toward " + str.tostring(prevClose, format.mintick) + " at " + entryAt + " if still unfilled"
        hColor := color.orange
    else if na(gapSize)
        headline := "WARMING UP - scroll the chart left to load more history"
        hColor := color.gray
    else
        headline := "NO TRADE - the gap is only " + str.tostring(gapSize, "0.00") + "x (needs " + str.tostring(thr, "0.0") + "x)"
        hColor := color.white
        if showAllGaps
            label.new(bar_index, high, "gap " + str.tostring(gapSize, "0.00") + "x", style = label.style_label_down, color = color.new(color.gray, 60), textcolor = color.white, size = size.tiny)
else if inRTH
    rthHi := math.max(rthHi, high)
    rthLo := math.min(rthLo, low)
if inRTH
    lastClose := close
    if not na(pcLine)
        line.set_x2(pcLine, bar_index)

// before the entry time: watch for the gap filling, and draw the PLAN (dashed target + stop)
if state == 1 and inRTH and not afterEntry
    if gapUp ? low <= prevClose : high >= prevClose
        touched := true
    preHi := math.max(preHi, high)
    preLo := math.min(preLo, low)
    if touched
        state := 3
        headline := "SKIPPED - the gap already filled before " + entryAt
        hColor := color.gray
        detail := ""
        if not na(pTgt)
            box.delete(pTgt)
            box.delete(pRisk)
            pTgt := na
            pRisk := na
    else
        int pSide = gapUp ? -1 : 1
        float pDist = math.abs(close - prevClose)
        float pRiskPts = stopMode == "Wide: 1:1 with the target" ? pDist : math.max(math.abs((gapUp ? preHi : preLo) - close), minRiskAtr * avgRange)
        float pStop = close - pSide * pRiskPts
        detail := "Target " + str.tostring(prevClose, format.mintick) + " (yesterday's close)   |   Stop about " + str.tostring(pStop, format.mintick) + "   |   Exit by " + exitAt
        string tTxt = "TARGET " + str.tostring(prevClose, format.mintick)
        string rTxt = "STOP about " + str.tostring(pStop, format.mintick)
        if na(pTgt)
            pTgt := box.new(dayStartBar, math.max(close, prevClose), bar_index + 1, math.min(close, prevClose), border_color = color.new(color.green, 30), border_style = line.style_dashed, bgcolor = color.new(color.green, 92), text = tTxt, text_color = color.green, text_size = size.small, text_halign = text.align_right, text_valign = pSide < 0 ? text.align_bottom : text.align_top)
            pRisk := box.new(dayStartBar, math.max(close, pStop), bar_index + 1, math.min(close, pStop), border_color = color.new(color.red, 30), border_style = line.style_dashed, bgcolor = color.new(color.red, 92), text = rTxt, text_color = color.red, text_size = size.small, text_halign = text.align_right, text_valign = pSide < 0 ? text.align_top : text.align_bottom)
        else
            box.set_top(pTgt, math.max(close, prevClose))
            box.set_bottom(pTgt, math.min(close, prevClose))
            box.set_right(pTgt, bar_index + 1)
            box.set_text(pTgt, tTxt)
            box.set_top(pRisk, math.max(close, pStop))
            box.set_bottom(pRisk, math.min(close, pStop))
            box.set_right(pRisk, bar_index + 1)
            box.set_text(pRisk, rTxt)

// entry
if entryBar and state == 1
    if not na(pTgt)
        box.delete(pTgt)
        box.delete(pRisk)
        pTgt := na
        pRisk := na
    float e = open
    bool okSide = gapUp ? e > prevClose : e < prevClose
    if not touched and okSide
        side := gapUp ? -1 : 1
        entryPx := e
        tgtPx := prevClose
        distPts := math.abs(e - prevClose)
        riskPts := stopMode == "Wide: 1:1 with the target" ? distPts : math.max(math.abs((gapUp ? preHi : preLo) - e), minRiskAtr * avgRange)
        stopPx := e - side * riskPts
        state := 2
        newTrade := true
        headline := (side < 0 ? "SHORT" : "LONG") + " IS ON - entered at " + str.tostring(e, format.mintick)
        hColor := color.aqua
        detail := "Target " + str.tostring(tgtPx, format.mintick) + "   |   Stop " + str.tostring(stopPx, format.mintick) + "   |   Exit by " + exitAt + " if neither is hit"
        bTgt := box.new(bar_index, math.max(e, tgtPx), bar_index + 1, math.min(e, tgtPx), border_color = color.new(color.green, 30), bgcolor = color.new(color.green, 82), text = "TARGET " + str.tostring(tgtPx, format.mintick), text_color = color.green, text_size = size.small, text_halign = text.align_right, text_valign = side < 0 ? text.align_bottom : text.align_top)
        bRisk := box.new(bar_index, math.max(e, stopPx), bar_index + 1, math.min(e, stopPx), border_color = color.new(color.red, 30), bgcolor = color.new(color.red, 82), text = "STOP " + str.tostring(stopPx, format.mintick), text_color = color.red, text_size = size.small, text_halign = text.align_right, text_valign = side < 0 ? text.align_top : text.align_bottom)
        label.new(bar_index, e, side < 0 ? "SELL" : "BUY", style = side < 0 ? label.style_label_down : label.style_label_up, color = side < 0 ? color.new(color.red, 10) : color.new(color.green, 10), textcolor = color.white, size = size.normal, tooltip = "Entry " + str.tostring(e, format.mintick) + "\nTarget " + str.tostring(tgtPx, format.mintick) + "\nStop " + str.tostring(stopPx, format.mintick) + "\nExit at " + exitAt + " if neither is hit.")
    else
        state := 3
        headline := "SKIPPED - price is already past yesterday's close"
        hColor := color.gray
        detail := ""

// manage the open trade
if state == 2
    bool timeUp = not beforeExit or not inRTH
    float res = na
    string how = ""
    if timeUp
        res := side * (open - entryPx) / riskPts
        how := "time exit"
    else if (side > 0 ? low <= stopPx : high >= stopPx)
        res := -1.0
        how := "stop hit"
    else if (side > 0 ? high >= tgtPx : low <= tgtPx)
        res := distPts / riskPts
        how := "target hit"
    box.set_right(bTgt, bar_index)
    box.set_right(bRisk, bar_index)
    if not na(res)
        nTr += 1
        rSum += res
        if res > 0
            nWin += 1
        state := 3
        headline := "TRADE DONE - " + (res >= 0 ? "+" : "") + str.tostring(res, "0.00") + "R (" + how + ")"
        hColor := res > 0 ? color.lime : color.red
        label.new(bar_index, how == "stop hit" ? stopPx : how == "target hit" ? tgtPx : open, (res > 0 ? "WIN +" : "LOSS ") + str.tostring(res, "0.00") + "R", style = label.style_label_left, color = res > 0 ? color.new(color.green, 20) : color.new(color.red, 20), textcolor = color.white, size = size.small, tooltip = "Ended by " + how + ". Before spread and commission.")

bgcolor(dayBig and beforeExit ? color.new(color.orange, 94) : na)

alertcondition(newTrade, "Big gap fade setup", "Big gap fade: entry time reached with an unfilled big gap. Trade toward yesterday's close.")

// ---------------------------------------------------------------- summary card
var table card = table.new(position.bottom_left, 1, 5, bgcolor = color.new(color.black, 0), border_width = 1, border_color = color.new(color.gray, 50))
if barstate.islast and showCard
    string prefix = inRTH ? "TODAY: " : "LAST SESSION: "
    int used = array.size(ranges)
    table.cell(card, 0, 0, prefix + headline, text_color = hColor, text_size = size.large, text_halign = text.align_left)
    table.cell(card, 0, 1, detail, text_color = color.white, text_size = size.normal, text_halign = text.align_left)
    table.cell(card, 0, 2, na(gapSize) ? "" : "Gap " + (gap > 0 ? "+" : "") + str.tostring(gap, format.mintick) + " points = " + str.tostring(gapSize, "0.00") + "x the normal daily range  (a big gap is " + str.tostring(thr, "0.0") + "x or more)", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(card, 0, 3, nTr > 0 ? "Past trades on this chart: " + str.tostring(nTr) + "  |  won " + str.tostring(100.0 * nWin / nTr, "#") + "%  |  average " + str.tostring(rSum / nTr, "0.00") + "R  (before costs)" : "No trades on the loaded history yet (about 1 day in 5 has a big gap)", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(card, 0, 4, not tfOk ? "Switch to a 1- to 15-minute chart" : used < rangeDays ? "Normal range is averaged from only " + str.tostring(used) + " of " + str.tostring(rangeDays) + " sessions - scroll the chart left to load more" : "", text_color = color.orange, text_size = size.small, text_halign = text.align_left)
