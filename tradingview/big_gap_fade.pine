//@version=6
indicator("Big Gap Fade (TradeLogger)", shorttitle = "TL Gap", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// =============================================================================
// The "big opening gap fade" from docs/PHASE_116_117_CONTEXT_PARTIALS_GAPS.md and
// docs/PHASE_118_GAP_PLUS_TJR_AND_REPLICATION.md. One rule, fixed:
//
//   1. GAP     09:30 open vs the previous day's 16:00 close (cash session).
//              BIG = at least 0.7 x the average daily range of the last 14 sessions.
//   2. ENTRY   at 09:45, IF the gap is still unfilled (price has not touched the
//              previous close since 09:30) and price is still on the gap side:
//              trade TOWARD the previous close (gap up -> short, gap down -> long).
//   3. TARGET  the previous close.
//   4. STOP    "wide": the same distance as the target (1:1). "tight": beyond the
//              09:30-to-entry extreme (at least 0.10 x the average range).
//   5. EXIT    target, stop, or 12:00, whichever comes first.
//
// Research result (NQ / ES / Dow / Russell, 3.5 years, after costs): about +0.05R per
// trade pooled; it worked in 2025-26 on NQ/ES (+0.13 to +0.18R) and not in 2023-24.
// NOT proven: forward-track it before trusting it. Results in the table here are
// BEFORE spread and commission, and only cover the bars loaded on your chart.
// Use a 1- to 5-minute chart (5-minute loads more history).
// =============================================================================

NY = "America/New_York"

grpG = "Gap"
thr = input.float(0.7, "Big gap = at least x the average daily range", minval = 0.1, step = 0.1, group = grpG,
     tooltip = "0.7 is the threshold from the research. 0.5 gives more days and a weaker effect; 1.0 fewer days and a stronger one.")
rangeDays = input.int(14, "Average range over the last N sessions", minval = 5, group = grpG)

grpT = "Trade"
entryAt = input.string("0945", "Enter at (New York time)", options = ["0935", "0940", "0945", "0950", "1000", "1015", "1030"], group = grpT)
exitAt = input.string("1200", "Exit at (New York time)", options = ["1100", "1130", "1200", "1300", "1330", "1555"], group = grpT)
stopMode = input.string("Wide: 1:1 with the target", "Stop", options = ["Wide: 1:1 with the target", "Tight: beyond the 09:30-to-entry extreme"], group = grpT,
     tooltip = "Wide: the stop is as far from your entry as the previous close is (about 257 points on NQ, 47 on ES), so use a SMALL position. It is rarely hit (5% of trades); most trades end at the time exit.\nTight: the stop is just beyond the opening-to-entry high (gap up) or low (gap down). Hit about 58% of the time, but bigger wins. More volatile; was flat before 2025.")
showSmall = input.bool(false, "Also label gaps that are NOT big", group = grpT)
showLegend = input.bool(true, "Show the 'how to read' box", group = grpT)

minRiskAtr = 0.10

// ---------------------------------------------------------------- session flags
inRTH = not na(time(timeframe.period, "0930-1600", NY))
rthStart = inRTH and not inRTH[1]
afterEntry = not na(time(timeframe.period, entryAt + "-1600", NY))
entryBar = afterEntry and not afterEntry[1]
beforeExit = not na(time(timeframe.period, "0930-" + exitAt, NY))
tfOk = timeframe.in_seconds() <= 900

// ---------------------------------------------------------------- per-day state
var float rthHi = na
var float rthLo = na
var float lastClose = na
var float prevClose = na
var float[] ranges = array.new_float()
var float avgRange = na
var float gap = na
var float gapSize = na
var bool dayBig = false
var bool gapUp = false
var bool touched = false
var float preHi = na
var float preLo = na
var int state = 0 // 0 = nothing to do today, 1 = waiting for the entry time, 2 = trade open, 3 = finished
var string statusTxt = "-"
var line pcLine = na

var float entryPx = na
var float stopPx = na
var float tgtPx = na
var float riskPts = na
var float distPts = na
var int side = 0
var box bTgt = na
var box bRisk = na

var int nBig = 0
var int nTr = 0
var int nWin = 0
var float rSum = 0.0

bool newTrade = false

if rthStart
    prevClose := lastClose
    if not na(rthHi)
        array.push(ranges, rthHi - rthLo)
        if array.size(ranges) > rangeDays
            array.shift(ranges)
    avgRange := array.size(ranges) >= rangeDays ? array.avg(ranges) : na
    rthHi := high
    rthLo := low
    gap := open - prevClose
    gapSize := (na(avgRange) or na(prevClose)) ? na : math.abs(gap) / avgRange
    dayBig := not na(gapSize) and gapSize >= thr
    gapUp := gap > 0
    touched := false
    preHi := high
    preLo := low
    state := dayBig ? 1 : 0
    if dayBig
        nBig += 1
    if not na(prevClose)
        pcLine := line.new(bar_index, prevClose, bar_index, prevClose, color = color.new(color.orange, 0), style = line.style_dashed, width = 1)
    string gtxt = na(gapSize) ? "Gap (warming up: needs " + str.tostring(rangeDays) + " sessions)" :
         "Gap " + (gap > 0 ? "+" : "") + str.tostring(gap, format.mintick) + "  (" + str.tostring(gapSize, "0.00") + "x range)" + (dayBig ? "  BIG" : "")
    if dayBig or (showSmall and not na(gapSize))
        label.new(bar_index, high, gtxt, style = label.style_label_down, color = dayBig ? color.new(color.orange, 15) : color.new(color.gray, 40),
             textcolor = color.white, size = size.small,
             tooltip = "Gap = 09:30 open minus the previous 16:00 close. BIG = at least " + str.tostring(thr) + " x the average of the last " + str.tostring(rangeDays) + " sessions' daily range.")
    statusTxt := na(gapSize) ? "warming up" : dayBig ? "BIG gap -> waiting for " + entryAt : "no big gap today (" + str.tostring(gapSize, "0.00") + "x)"
else if inRTH
    rthHi := math.max(rthHi, high)
    rthLo := math.min(rthLo, low)
if inRTH
    lastClose := close
    if not na(pcLine)
        line.set_x2(pcLine, bar_index)

// before the entry time: has the gap already filled?
if state == 1 and inRTH and not afterEntry
    if gapUp ? low <= prevClose : high >= prevClose
        touched := true
    preHi := math.max(preHi, high)
    preLo := math.min(preLo, low)

// entry
if entryBar and state == 1
    float e = open
    bool okSide = gapUp ? e > prevClose : e < prevClose
    if not touched and okSide
        side := gapUp ? -1 : 1
        entryPx := e
        tgtPx := prevClose
        distPts := math.abs(e - prevClose)
        riskPts := stopMode == "Wide: 1:1 with the target" ? distPts : math.max(math.abs((gapUp ? preHi : preLo) - e), minRiskAtr * avgRange)
        stopPx := e - side * riskPts
        state := 2
        newTrade := true
        statusTxt := (side < 0 ? "SHORT" : "LONG") + " open toward " + str.tostring(prevClose, format.mintick)
        bTgt := box.new(bar_index, math.max(e, tgtPx), bar_index + 1, math.min(e, tgtPx), border_color = color.new(color.green, 40), bgcolor = color.new(color.green, 88))
        bRisk := box.new(bar_index, math.max(e, stopPx), bar_index + 1, math.min(e, stopPx), border_color = color.new(color.red, 40), bgcolor = color.new(color.red, 88))
        label.new(bar_index, e, (side < 0 ? "FADE ▼ " : "FADE ▲ ") + str.tostring(gapSize, "0.00") + "x", style = side < 0 ? label.style_label_down : label.style_label_up,
             color = side < 0 ? color.new(color.red, 10) : color.new(color.green, 10), textcolor = color.white, size = size.small,
             tooltip = (side < 0 ? "SHORT" : "LONG") + " toward the previous close\nEntry " + str.tostring(e, format.mintick) + "\nTarget " + str.tostring(tgtPx, format.mintick) +
             "\nStop " + str.tostring(stopPx, format.mintick) + "\nRisk " + str.tostring(riskPts, format.mintick) + " points\nExit at " + exitAt + " if neither is hit.")
    else
        state := 3
        statusTxt := touched ? "skipped: gap already filled by " + entryAt : "skipped: price already past the previous close"

// manage the open trade
if state == 2
    bool timeUp = not beforeExit or not inRTH
    float res = na
    string how = ""
    if timeUp
        res := side * (open - entryPx) / riskPts
        how := "time"
    else if (side > 0 ? low <= stopPx : high >= stopPx)
        res := -1.0
        how := "stop"
    else if (side > 0 ? high >= tgtPx : low <= tgtPx)
        res := distPts / riskPts
        how := "target"
    box.set_right(bTgt, bar_index)
    box.set_right(bRisk, bar_index)
    if not na(res)
        nTr += 1
        rSum += res
        if res > 0
            nWin += 1
        state := 3
        statusTxt := "finished: " + (res >= 0 ? "+" : "") + str.tostring(res, "0.00") + "R (" + how + ")"
        label.new(bar_index, how == "stop" ? stopPx : how == "target" ? tgtPx : open, (res > 0 ? "✓ +" : "✗ ") + str.tostring(res, "0.00") + "R", style = label.style_label_left,
             color = res > 0 ? color.new(color.green, 20) : color.new(color.red, 20), textcolor = color.white, size = size.tiny,
             tooltip = "Ended by " + how + ". Before spread and commission.")

bgcolor(dayBig and beforeExit ? color.new(color.orange, 93) : na)

alertcondition(newTrade, "Big gap fade setup", "Big gap fade: entry time reached with an unfilled big gap. Trade toward the previous close.")

// ---------------------------------------------------------------- tables
var table tb = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast
    table.cell(tb, 0, 0, "Big gap fade", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, "today: " + statusTxt, text_color = color.orange, text_size = size.small)
    table.cell(tb, 0, 1, "Big-gap days on chart", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 1, str.tostring(nBig), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Trades taken", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 2, str.tostring(nTr), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Win rate", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 3, nTr > 0 ? str.tostring(100.0 * nWin / nTr, "#.0") + "%" : "-", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 4, "Average R", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 4, nTr > 0 ? str.tostring(rSum / nTr, "#.00") : "-", text_color = rSum >= 0 ? color.lime : color.red, text_size = size.small)
    table.cell(tb, 0, 5, "Total R", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 5, str.tostring(rSum, "#.0"), text_color = rSum >= 0 ? color.lime : color.red, text_size = size.small)
    table.cell(tb, 0, 6, "Before spread/commission", text_color = color.gray, text_size = size.tiny)
    table.cell(tb, 1, 6, "only the bars loaded", text_color = color.gray, text_size = size.tiny)
    table.cell(tb, 0, 7, tfOk ? "" : "Use a 1-15 minute chart", text_color = color.red, text_size = size.small)
    table.cell(tb, 1, 7, "", text_size = size.tiny)

var table legend = table.new(position.bottom_right, 1, 6, bgcolor = color.new(color.black, 25))
if barstate.islast and showLegend
    table.cell(legend, 0, 0, "How to read  ·  one rule: fade a BIG opening gap toward the previous close", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(legend, 0, 1, "Orange line = previous day's 16:00 close (the target)", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(legend, 0, 2, "Orange shading + 'Gap ... BIG' = a gap worth fading today", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(legend, 0, 3, "FADE ▼ / ▲ = entry at " + entryAt + " if the gap is still unfilled", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(legend, 0, 4, "Green box = target zone · red box = stop zone", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(legend, 0, 5, "✓ / ✗ = how it ended, in R (exit by target, stop, or " + exitAt + ")", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
