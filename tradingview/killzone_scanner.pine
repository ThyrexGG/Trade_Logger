//@version=5
strategy(
     "Killzone Liquidity Sweep + MSS (TradeLogger port)",
     shorttitle = "TL Killzone",
     overlay = true,
     initial_capital = 10000,
     // Position size is computed explicitly per trade from riskPercent below
     // (equity x risk% / stop distance), not from these defaults -- they
     // only matter as a fallback if that calculation ever fails to produce
     // a qty (e.g. riskDist <= 0, which is already guarded against).
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     calc_on_every_tick = false,
     process_orders_on_close = true)

// =============================================================================
// A TradingView port of killzone_scanner.py (TradeLogger's web app) so the
// same sweep + market-structure-shift ("MSS") idea can be backtested with
// TradingView's own Strategy Tester instead of trusting the web app's numbers
// blind. It is a PORT, not a guaranteed byte-identical copy:
//   - Swing points use Pine's built-in ta.pivothigh/ta.pivotlow, which confirm
//     a swing the same "N bars each side" way killzone_scanner.py's rolling-
//     window swing detector does.
//   - Sweep / MSS / pairing logic mirrors detect_liquidity_sweeps(),
//     detect_structure_shifts() and find_candidates() in killzone_scanner.py.
//   - The one real difference: the web app's backtest-style "potential
//     target" is the nearest real untapped liquidity pool from
//     calculate_liquidity_zones() (market_data.py) — Pine has no equivalent
//     to that computation here, so this script instead uses a plain
//     risk-multiple target (an input you set), same as most Pine strategies.
//     Expect this script's exact win/loss numbers to differ from the web
//     app's candidates for that reason; the ENTRY/STOP logic (the part that
//     actually defines a candidate) is the same.
// Pattern-flagging / backtesting tool only — not a signal, not investment
// advice, and running this strategy live is your own decision entirely
// outside TradeLogger.
// =============================================================================

// ---- Inputs -----------------------------------------------------------
grp1 = "Detection (mirrors killzone_scanner.py)"
swingLookback     = input.int(5, "Swing lookback (bars each side)", minval = 2, group = grp1)
minDispATRMult    = input.float(0.5, "Min displacement for a shift (x ATR)", minval = 0.0, step = 0.1, group = grp1)
atrLength         = input.int(14, "ATR length", minval = 1, group = grp1)
maxBarsAfterSweep = input.int(6, "Max bars from sweep to shift", minval = 1, group = grp1)

grp2 = "Killzone filter (New York time, matching killzone_scanner.py)"
useKillzoneFilter = input.bool(false, "Only take trades inside a named killzone", group = grp2)
showKillzoneBg    = input.bool(true, "Shade killzone windows on the chart", group = grp2)

grp3 = "Backtest"
enableBacktest = input.bool(true, "Place backtest orders (off = visual markers only)", group = grp3)
rrMultiple     = input.float(2.0, "Target = stop distance x this multiple", minval = 0.1, step = 0.1, group = grp3)
riskPercent    = input.float(1.0, "Risk % of equity per trade", minval = 0.01, step = 0.1, group = grp3,
     tooltip = "Position size is calculated so that if the stop is hit, the loss is this % of current equity -- not a flat contract count. Raise/lower this to see how account risk changes drawdown and total return; it does not change which trades fire, only how big they are.")
maxLeverage    = input.float(200, "Max account leverage (a real broker's limit)", minval = 1, group = grp3,
     tooltip = "Caps position size to what this leverage can actually fund (e.g. 30 = a position worth at most 30x your equity). Backtesting has no margin limit by default -- on a tight-stop pair, risk-based sizing can call for a position worth millions on a 5K account, which no real broker allows. When the risk-sized quantity would need more leverage than this, size is capped here instead, so realized risk on a very tight stop may land under riskPercent -- that's the honest, fundable number, not a bug.")

// ---- Swing points -------------------------------------------------------
// ta.pivothigh/pivotlow confirm `swingLookback` bars AFTER the actual pivot
// bar, the same lag killzone_scanner.py's centered rolling-window swing
// detector has (a swing isn't "confirmed" until bars exist on both sides).
swingHighVal = ta.pivothigh(high, swingLookback, swingLookback)
swingLowVal  = ta.pivotlow(low, swingLookback, swingLookback)

var float lastSwingHigh = na
var float lastSwingLow  = na
if not na(swingHighVal)
    lastSwingHigh := swingHighVal
if not na(swingLowVal)
    lastSwingLow := swingLowVal

// ---- Displacement ---------------------------------------------------------
atrVal          = ta.atr(atrLength)
bodySize        = math.abs(close - open)
hasDisplacement = bodySize >= atrVal * minDispATRMult

// ---- Killzones (ICT-style, New York clock — same windows as
// killzone_scanner.py's _killzone_for_timestamp) ---------------------------
inLondonKZ = not na(time(timeframe.period, "0200-0500", "America/New_York"))
inNyAmKZ   = not na(time(timeframe.period, "0830-1100", "America/New_York"))
inNyPmKZ   = not na(time(timeframe.period, "1330-1600", "America/New_York"))
inKillzone = inLondonKZ or inNyAmKZ or inNyPmKZ

bgcolor(showKillzoneBg and inKillzone ? color.new(color.blue, 92) : na, title = "Killzone window")

// ---- Sweeps: a wick clears a confirmed swing, then closes back through it -
bslSweep = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh
sslSweep = not na(lastSwingLow)  and low  < lastSwingLow  and close > lastSwingLow

var float sslSweepLevel = na
var int   sslSweepBar   = na
var float bslSweepLevel = na
var int   bslSweepBar   = na

if sslSweep
    sslSweepLevel := lastSwingLow
    sslSweepBar   := bar_index
if bslSweep
    bslSweepLevel := lastSwingHigh
    bslSweepBar   := bar_index

// ---- Structure shift (MSS): close beyond the opposing swing, with real
// displacement — not just a wick poking through the level. -----------------
bullishShift = not na(lastSwingHigh) and close > lastSwingHigh and hasDisplacement
bearishShift = not na(lastSwingLow)  and close < lastSwingLow  and hasDisplacement

// ---- Pair each shift with the nearest prior opposing-direction sweep -----
killzoneOk = useKillzoneFilter ? inKillzone : true
bullishCandidate = bullishShift and not na(sslSweepBar) and (bar_index - sslSweepBar) <= maxBarsAfterSweep and killzoneOk
bearishCandidate = bearishShift and not na(bslSweepBar) and (bar_index - bslSweepBar) <= maxBarsAfterSweep and killzoneOk

// ---- Visual markers -------------------------------------------------------
plotshape(sslSweep, title = "SSL sweep", style = shape.triangleup, location = location.belowbar,
     color = color.gray, size = size.tiny, text = "sweep")
plotshape(bslSweep, title = "BSL sweep", style = shape.triangledown, location = location.abovebar,
     color = color.gray, size = size.tiny, text = "sweep")
plotshape(bullishCandidate, title = "Bullish MSS", style = shape.triangleup, location = location.belowbar,
     color = color.green, size = size.small, text = "MSS")
plotshape(bearishCandidate, title = "Bearish MSS", style = shape.triangledown, location = location.abovebar,
     color = color.red, size = size.small, text = "MSS")

// ---- Entry / stop / target lines -------------------------------------
// Drawn every time a candidate fires, whether or not `enableBacktest` is on
// -- TradingView only auto-draws strategy.entry/exit markers when an actual
// order was placed, and even then they're small built-in arrows, not an
// explicit plan you can read at a glance the way the web app shows one. This
// draws the same three levels (entry / stop / target) as real lines +
// labels regardless, so "what would this trade have looked like" is always
// visible, even with backtesting switched off.
grp4 = "Chart"
planLineBars = input.int(15, "How many bars the entry/stop/target lines extend", minval = 1, group = grp4)

drawPlan(entryLevel, stopLevel, targetLevel) =>
    x1 = bar_index
    x2 = bar_index + planLineBars
    line.new(x1, entryLevel, x2, entryLevel, color = color.yellow, width = 2, style = line.style_solid)
    line.new(x1, stopLevel, x2, stopLevel, color = color.red, width = 1, style = line.style_dashed)
    line.new(x1, targetLevel, x2, targetLevel, color = color.green, width = 1, style = line.style_dashed)
    label.new(x2, entryLevel, "Entry " + str.tostring(entryLevel, format.mintick),
         style = label.style_label_left, color = color.new(color.yellow, 85), textcolor = color.yellow, size = size.tiny)
    label.new(x2, stopLevel, "Stop " + str.tostring(stopLevel, format.mintick),
         style = label.style_label_left, color = color.new(color.red, 85), textcolor = color.red, size = size.tiny)
    label.new(x2, targetLevel, "Target " + str.tostring(targetLevel, format.mintick),
         style = label.style_label_left, color = color.new(color.green, 85), textcolor = color.green, size = size.tiny)

// Position size from risk, not a flat contract count: qty such that a stop-
// out costs exactly riskPercent% of CURRENT equity (equity compounds trade
// to trade, same as the web app's own risk-of-ruin sizing logic elsewhere
// in this project).
//
// riskDist is a raw PRICE difference (e.g. ~0.1 for a USDJPY stop), and
// syminfo.pointvalue x riskDist gives the P&L of that move in the
// INSTRUMENT'S OWN quote currency (JPY for a *JPY pair) -- not necessarily
// the account's currency. Verified against a real backtest: leaving out the
// quote->account conversion (dividing by `close`, the current JPY-per-USD
// rate) undersized every trade by roughly that exchange rate (~150x on
// USDJPY), producing a backtest with an unrealistically tiny drawdown that
// looked fine at a glance but wasn't actually risking what riskPercent said.
// This is the same reason real forex "pip value" calculators always ask for
// the current rate specifically on JPY-quoted pairs, unlike e.g. EURUSD
// where quote currency and a USD account already match.
// Verified against a real backtest: with no cap, a tight USDJPY stop called
// for positions worth millions on a $5K account -- correct arithmetic, but a
// leverage no real broker offers. maxQty is the largest position this
// script will ever open at maxLeverage; wanted is clamped to it so realized
// risk quietly comes in under riskPercent on very tight stops instead of
// silently assuming unlimited leverage.
riskSize(riskDist) =>
    wanted = (strategy.equity * riskPercent / 100 * close) / (riskDist * syminfo.pointvalue)
    maxQty = (strategy.equity * maxLeverage) / close
    math.min(wanted, maxQty)

// A strategy.entry() in the opposite direction of an already-open position
// closes it immediately at the current price and reverses -- not at that
// trade's own stop or target. Left unguarded, every trade's real outcome
// gets overwritten by whatever the next signal happens to be, and the
// backtest's win/loss averages stop meaning what the rrMultiple input says
// they should. `strategy.position_size == 0` gates a new entry to only when
// nothing is already open, so each trade plays out to its own stop/target
// before the next one is considered -- one candidate, one full trade.
flat = strategy.position_size == 0

if bullishCandidate
    stopLevel  = sslSweepLevel
    entryLevel = close
    riskDist   = entryLevel - stopLevel
    if riskDist > 0
        targetLevel = entryLevel + riskDist * rrMultiple
        drawPlan(entryLevel, stopLevel, targetLevel)
        if enableBacktest and flat
            strategy.entry("Long", strategy.long, qty = riskSize(riskDist))
            strategy.exit("Long exit", from_entry = "Long", stop = stopLevel, limit = targetLevel)

if bearishCandidate
    stopLevel  = bslSweepLevel
    entryLevel = close
    riskDist   = stopLevel - entryLevel
    if riskDist > 0
        targetLevel = entryLevel - riskDist * rrMultiple
        drawPlan(entryLevel, stopLevel, targetLevel)
        if enableBacktest and flat
            strategy.entry("Short", strategy.short, qty = riskSize(riskDist))
            strategy.exit("Short exit", from_entry = "Short", stop = stopLevel, limit = targetLevel)

alertcondition(bullishCandidate, title = "Bullish sweep+MSS", message = "Bullish liquidity sweep + MSS candidate")
alertcondition(bearishCandidate, title = "Bearish sweep+MSS", message = "Bearish liquidity sweep + MSS candidate")

// =============================================================================
// Out-of-sample split -- the single most important check before trusting any
// backtest (see README). Everything before `oosStart` is "development": tune
// inputs freely against it. Everything after is out-of-sample: read the
// numbers, then change NOTHING in response to them -- tuning against the
// out-of-sample period just turns it into more development data with extra
// steps. The table below computes win rate / profit factor / expectancy for
// each half separately so this comparison doesn't require two manual runs.
// =============================================================================
grp5 = "Out-of-sample check"
useOosSplit = input.bool(true, "Split results into in-sample vs out-of-sample", group = grp5)
oosStart = input.time(timestamp("01 Jan 2026 00:00 +0000"), "Out-of-sample starts", group = grp5,
     tooltip = "Development/tuning happens on data BEFORE this date only. After seeing the out-of-sample column, change nothing -- if you adjust an input because you didn't like this column, you have just moved the goalposts and are overfitting to it too.")

bgcolor(useOosSplit and time >= oosStart ? color.new(color.orange, 94) : na, title = "Out-of-sample period")

var table oosTable = table.new(position.top_right, 3, 4, border_width = 1)

if barstate.islast and useOosSplit
    int isTrades = 0
    int oosTrades = 0
    float isWins = 0.0
    float oosWins = 0.0
    float isProfit = 0.0
    float isLoss = 0.0
    float oosProfit = 0.0
    float oosLoss = 0.0

    for i = 0 to strategy.closedtrades - 1
        entryTime = strategy.closedtrades.entry_time(i)
        pnl = strategy.closedtrades.profit(i)
        if entryTime >= oosStart
            oosTrades += 1
            if pnl > 0
                oosWins += 1
                oosProfit += pnl
            else
                oosLoss += -pnl
        else
            isTrades += 1
            if pnl > 0
                isWins += 1
                isProfit += pnl
            else
                isLoss += -pnl

    headerBg = color.new(color.gray, 70)
    table.cell(oosTable, 0, 0, "", bgcolor = headerBg)
    table.cell(oosTable, 1, 0, "In-sample", text_color = color.white, bgcolor = headerBg)
    table.cell(oosTable, 2, 0, "Out-of-sample", text_color = color.orange, bgcolor = headerBg)

    table.cell(oosTable, 0, 1, "Trades")
    table.cell(oosTable, 1, 1, str.tostring(isTrades))
    table.cell(oosTable, 2, 1, str.tostring(oosTrades))

    table.cell(oosTable, 0, 2, "Win rate")
    table.cell(oosTable, 1, 2, isTrades > 0 ? str.tostring(isWins / isTrades * 100, "#.#") + "%" : "n/a")
    table.cell(oosTable, 2, 2, oosTrades > 0 ? str.tostring(oosWins / oosTrades * 100, "#.#") + "%" : "n/a")

    table.cell(oosTable, 0, 3, "Profit factor")
    table.cell(oosTable, 1, 3, isLoss > 0 ? str.tostring(isProfit / isLoss, "#.##") : (isProfit > 0 ? "∞" : "n/a"))
    table.cell(oosTable, 2, 3, oosLoss > 0 ? str.tostring(oosProfit / oosLoss, "#.##") : (oosProfit > 0 ? "∞" : "n/a"))
