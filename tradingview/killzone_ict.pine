// This source code is subject to the terms of the Mozilla Public License 2.0
// at https://mozilla.org/MPL/2.0/
//
// The ICT killzone / session-pivot concepts and their default session windows
// are adapted from "ICT Killzones & Pivots [TFO]" (MPL-2.0, (c) tradeforopp).
// This is an independent reimplementation in Pine v5 as a STRATEGY -- TFO's
// original is a v6 indicator and cannot be merged directly, since a Pine
// script is either backtestable or a drawing tool, never both. Attribution
// retained per MPL-2.0.
//
// (c) TradeLogger -- sweep/MSS entry logic, position sizing, out-of-sample split

//@version=5
strategy(
     "Killzone Sweep + MSS + ICT Killzones (TradeLogger)",
     shorttitle = "TL Killzone ICT",
     overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     max_boxes_count = 500,
     max_lines_count = 500,
     max_labels_count = 500)

// =============================================================================
// Combines two things:
//
//   1. The TradeLogger sweep + market-structure-shift strategy (entries, risk
//      sizing, leverage cap, out-of-sample split) -- identical trade logic to
//      killzone_scanner.pine, so backtests stay comparable. The sweep/MSS
//      shape markers are OFF by default here; the entry/stop/target plan lines
//      remain.
//
//   2. ICT killzone visuals: session boxes, each session's high/low as pivots
//      that extend until price trades through them, hit-rate stats in the
//      label tooltips, and previous day/week/month high/low/midline.
//
// IMPORTANT: the killzone windows used for the ENTRY FILTER are separate
// inputs from the visual killzone boxes, on purpose. If the boxes drove entry
// eligibility, editing a box's session time would silently change which
// trades fire and break comparability with previously recorded backtests.
// Visuals are visuals; trade logic is trade logic.
//
// Pattern-flagging / backtesting tool only -- not a signal, not investment
// advice. Note the honest finding from testing THIS logic across 664
// cost-adjusted trades on 6 pairs: profit factor below 1.0 at every
// configuration. Treat it as a discretionary context tool, not a system.
// =============================================================================

// ---- Detection inputs ---------------------------------------------------
grp1 = "Detection (mirrors killzone_scanner.py)"
swingLookback     = input.int(5, "Swing lookback (bars each side)", minval = 2, group = grp1)
minDispATRMult    = input.float(0.5, "Min displacement for a shift (x ATR)", minval = 0.0, step = 0.1, group = grp1)
atrLength         = input.int(14, "ATR length", minval = 1, group = grp1)
maxBarsAfterSweep = input.int(6, "Max bars from sweep to shift", minval = 1, group = grp1)

grp2 = "Entry killzone filter (SEPARATE from the visual boxes)"
useKillzoneFilter = input.bool(false, "Only take trades inside these windows", group = grp2,
     tooltip = "These windows gate ENTRIES and are intentionally independent of the visual killzone boxes below, so editing a box never silently changes your backtest.")
entryLondon = input.session("0200-0500", "Entry window 1 (London)", group = grp2)
entryNyAm   = input.session("0830-1100", "Entry window 2 (NY AM)", group = grp2)
entryNyPm   = input.session("1330-1600", "Entry window 3 (NY PM)", group = grp2)

grp3 = "Backtest"
enableBacktest = input.bool(true, "Place backtest orders (off = visual only)", group = grp3)
rrMultiple     = input.float(2.0, "Target = stop distance x this multiple", minval = 0.1, step = 0.1, group = grp3)
riskPercent    = input.float(1.0, "Risk % of equity per trade", minval = 0.01, step = 0.1, group = grp3,
     tooltip = "Position size is calculated so that if the stop is hit, the loss is this % of current equity -- not a flat contract count.")
maxLeverage    = input.float(200, "Max account leverage (a real broker's limit)", minval = 1, group = grp3,
     tooltip = "Caps position size to what this leverage can actually fund. Backtesting has no margin limit by default; on a tight-stop pair, risk-based sizing can call for a position worth millions on a 5K account.")

grp4 = "Signal display"
showSignalMarkers = input.bool(false, "Show sweep / MSS shape markers", group = grp4,
     tooltip = "Off by default -- these clutter the chart badly on lower timeframes. The entry/stop/target plan lines below are unaffected.")
showPlanLines = input.bool(true, "Show entry / stop / target lines", group = grp4)
planLineBars  = input.int(15, "How far the plan lines extend (bars)", minval = 1, group = grp4)

// ---- ICT killzone visuals ------------------------------------------------
grpKZ = "ICT Killzones"
showKzBoxes  = input.bool(true, "Show session boxes", group = grpKZ)
showKzPivots = input.bool(true, "Show session high/low pivots", group = grpKZ,
     tooltip = "Each session's high and low extend to the right until price trades through them.")
showKzLabels = input.bool(true, "Label pivots (hover for hit rate)", group = grpKZ)
kzMaxDays    = input.int(3, "Sessions kept on chart", minval = 1, maxval = 40, group = grpKZ)
kzTz         = input.string("America/New_York", "Timezone", group = grpKZ,
     options = ["America/New_York", "America/Chicago", "America/Los_Angeles", "Europe/London", "Europe/Berlin", "Asia/Tokyo", "Asia/Shanghai", "Australia/Sydney", "GMT"])
kzTfLimit    = input.timeframe("240", "Hide killzones at or above this timeframe", group = grpKZ,
     tooltip = "Session boxes are meaningless on high timeframes where one bar spans several sessions.")

useAsia  = input.bool(true,  "", inline = "KA", group = grpKZ)
asiaCol  = input.color(color.new(color.blue, 85), "", inline = "KA", group = grpKZ)
asiaTxt  = input.string("ASIA", "", inline = "KA", group = grpKZ)
asiaSess = input.session("2000-0000", "", inline = "KA", group = grpKZ)

useLdn   = input.bool(true,  "", inline = "KL", group = grpKZ)
ldnCol   = input.color(color.new(color.red, 85), "", inline = "KL", group = grpKZ)
ldnTxt   = input.string("LNDN", "", inline = "KL", group = grpKZ)
ldnSess  = input.session("0200-0500", "", inline = "KL", group = grpKZ)

useNyAm  = input.bool(true,  "", inline = "KN", group = grpKZ)
nyAmCol  = input.color(color.new(color.teal, 85), "", inline = "KN", group = grpKZ)
nyAmTxt  = input.string("NYAM", "", inline = "KN", group = grpKZ)
nyAmSess = input.session("0930-1100", "", inline = "KN", group = grpKZ)

useNyPm  = input.bool(true,  "", inline = "KP", group = grpKZ)
nyPmCol  = input.color(color.new(color.fuchsia, 85), "", inline = "KP", group = grpKZ)
nyPmTxt  = input.string("NYPM", "", inline = "KP", group = grpKZ)
nyPmSess = input.session("1330-1600", "", inline = "KP", group = grpKZ)

grpDWM = "Previous day / week / month levels"
showPD  = input.bool(true,  "Previous day high/low", inline = "D", group = grpDWM)
showPDM = input.bool(true,  "midline", inline = "D", group = grpDWM)
pdCol   = input.color(color.blue, "", inline = "D", group = grpDWM)

showPW  = input.bool(true,  "Previous week high/low", inline = "W", group = grpDWM)
showPWM = input.bool(false, "midline", inline = "W", group = grpDWM)
pwCol   = input.color(#089981, "", inline = "W", group = grpDWM)

showPM  = input.bool(false, "Previous month high/low", inline = "M", group = grpDWM)
showPMM = input.bool(false, "midline", inline = "M", group = grpDWM)
pmCol   = input.color(color.red, "", inline = "M", group = grpDWM)

grp5 = "Out-of-sample check"
useOosSplit = input.bool(true, "Split results into in-sample vs out-of-sample", group = grp5)
oosStart = input.time(timestamp("01 Jan 2026 00:00 +0000"), "Out-of-sample starts", group = grp5,
     tooltip = "Development happens on data BEFORE this date only. After seeing the out-of-sample column, change nothing.")

// =============================================================================
// STRATEGY LOGIC -- unchanged from killzone_scanner.pine so results stay
// comparable with previously recorded backtests.
// =============================================================================
swingHighVal = ta.pivothigh(high, swingLookback, swingLookback)
swingLowVal  = ta.pivotlow(low, swingLookback, swingLookback)

var float lastSwingHigh = na
var float lastSwingLow  = na
if not na(swingHighVal)
    lastSwingHigh := swingHighVal
if not na(swingLowVal)
    lastSwingLow := swingLowVal

atrVal          = ta.atr(atrLength)
bodySize        = math.abs(close - open)
hasDisplacement = bodySize >= atrVal * minDispATRMult

inEntryKz = not na(time(timeframe.period, entryLondon, "America/New_York"))
     or not na(time(timeframe.period, entryNyAm, "America/New_York"))
     or not na(time(timeframe.period, entryNyPm, "America/New_York"))

bslSweep = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh
sslSweep = not na(lastSwingLow)  and low  < lastSwingLow  and close > lastSwingLow

var float sslSweepLevel = na
var int   sslSweepBar   = na
var float bslSweepLevel = na
var int   bslSweepBar   = na

if sslSweep
    sslSweepLevel := lastSwingLow
    sslSweepBar   := bar_index
if bslSweep
    bslSweepLevel := lastSwingHigh
    bslSweepBar   := bar_index

bullishShift = not na(lastSwingHigh) and close > lastSwingHigh and hasDisplacement
bearishShift = not na(lastSwingLow)  and close < lastSwingLow  and hasDisplacement

killzoneOk = useKillzoneFilter ? inEntryKz : true
bullishCandidate = bullishShift and not na(sslSweepBar) and (bar_index - sslSweepBar) <= maxBarsAfterSweep and killzoneOk
bearishCandidate = bearishShift and not na(bslSweepBar) and (bar_index - bslSweepBar) <= maxBarsAfterSweep and killzoneOk

// Markers default OFF -- this is the "spam" on lower timeframes.
plotshape(showSignalMarkers and sslSweep, title = "SSL sweep", style = shape.triangleup,
     location = location.belowbar, color = color.gray, size = size.tiny)
plotshape(showSignalMarkers and bslSweep, title = "BSL sweep", style = shape.triangledown,
     location = location.abovebar, color = color.gray, size = size.tiny)
plotshape(showSignalMarkers and bullishCandidate, title = "Bullish MSS", style = shape.triangleup,
     location = location.belowbar, color = color.green, size = size.small, text = "MSS")
plotshape(showSignalMarkers and bearishCandidate, title = "Bearish MSS", style = shape.triangledown,
     location = location.abovebar, color = color.red, size = size.small, text = "MSS")

drawPlan(entryLevel, stopLevel, targetLevel) =>
    if showPlanLines
        x1 = bar_index
        x2 = bar_index + planLineBars
        line.new(x1, entryLevel, x2, entryLevel, color = color.yellow, width = 2)
        line.new(x1, stopLevel, x2, stopLevel, color = color.red, width = 1, style = line.style_dashed)
        line.new(x1, targetLevel, x2, targetLevel, color = color.green, width = 1, style = line.style_dashed)
        label.new(x2, entryLevel, "Entry " + str.tostring(entryLevel, format.mintick),
             style = label.style_label_left, color = color.new(color.yellow, 85), textcolor = color.yellow, size = size.tiny)
        label.new(x2, stopLevel, "Stop " + str.tostring(stopLevel, format.mintick),
             style = label.style_label_left, color = color.new(color.red, 85), textcolor = color.red, size = size.tiny)
        label.new(x2, targetLevel, "Target " + str.tostring(targetLevel, format.mintick),
             style = label.style_label_left, color = color.new(color.green, 85), textcolor = color.green, size = size.tiny)

// Quote-currency -> account-currency conversion, derived from the symbol
// rather than hardcoded (see killzone_scanner.pine for the full history --
// a hardcoded JPY assumption broke XAUUSD outright).
quoteToAccount() =>
    rate = 1.0
    if syminfo.currency != strategy.account_currency
        rate := syminfo.basecurrency == strategy.account_currency ? 1.0 / close : na
    rate

riskSize(riskDist) =>
    rate = quoteToAccount()
    qty  = 0.0
    if not na(rate) and riskDist > 0 and strategy.equity > 0
        wanted = (strategy.equity * riskPercent / 100) / (riskDist * syminfo.pointvalue * rate)
        maxQty = (strategy.equity * maxLeverage) / close
        qty := math.max(0.0, math.min(wanted, maxQty))
    qty

flat = strategy.position_size == 0

if bullishCandidate
    stopLevel  = sslSweepLevel
    entryLevel = close
    riskDist   = entryLevel - stopLevel
    if riskDist > 0
        targetLevel = entryLevel + riskDist * rrMultiple
        drawPlan(entryLevel, stopLevel, targetLevel)
        qty = riskSize(riskDist)
        if enableBacktest and flat and qty > 0
            strategy.entry("Long", strategy.long, qty = qty)
            strategy.exit("Long exit", from_entry = "Long", stop = stopLevel, limit = targetLevel)

if bearishCandidate
    stopLevel  = bslSweepLevel
    entryLevel = close
    riskDist   = stopLevel - entryLevel
    if riskDist > 0
        targetLevel = entryLevel - riskDist * rrMultiple
        drawPlan(entryLevel, stopLevel, targetLevel)
        qty = riskSize(riskDist)
        if enableBacktest and flat and qty > 0
            strategy.entry("Short", strategy.short, qty = qty)
            strategy.exit("Short exit", from_entry = "Short", stop = stopLevel, limit = targetLevel)

alertcondition(bullishCandidate, title = "Bullish sweep+MSS", message = "Bullish liquidity sweep + MSS candidate")
alertcondition(bearishCandidate, title = "Bearish sweep+MSS", message = "Bearish liquidity sweep + MSS candidate")

if barstate.islast and na(quoteToAccount())
    label.new(bar_index, high, "Position sizing unavailable\n" + syminfo.currency + " -> " + strategy.account_currency
         + " needs a rate this chart doesn't carry.\nNo orders placed.",
         style = label.style_label_down, color = color.new(color.red, 15), textcolor = color.white, size = size.small)

// =============================================================================
// ICT KILLZONES -- boxes, session pivots, hit-rate tracking
// =============================================================================
type KZone
    string       name
    color        col
    array<box>   boxes
    array<line>  hiLines
    array<line>  loLines
    array<label> hiLabels
    array<label> loLabels
    bool         hiOpen      // most recent session's high not yet traded through
    bool         loOpen
    bool         hiTaken     // was it taken during the tracking window
    bool         loTaken
    bool         started
    int          nSessions   // resolved sessions only
    int          hiHits
    int          loHits

newZone(string nm, color c) =>
    KZone.new(nm, c, array.new<box>(), array.new<line>(), array.new<line>(),
         array.new<label>(), array.new<label>(), false, false, false, false, false, 0, 0, 0)

var KZone zAsia = newZone(asiaTxt, asiaCol)
var KZone zLdn  = newZone(ldnTxt,  ldnCol)
var KZone zNyAm = newZone(nyAmTxt, nyAmCol)
var KZone zNyPm = newZone(nyPmTxt, nyPmCol)

kzVisible = timeframe.in_seconds("") < timeframe.in_seconds(kzTfLimit)

hitRateText(string nm, string side, float px, int hits, int n) =>
    string s = nm + " " + side + ": " + str.tostring(px, format.mintick)
    if n > 0
        s += "\nSwept in " + str.tostring(math.round(hits / n * 100)) + "% of the last "
             + str.tostring(n) + " sessions"
        s += "\n(counted after each session closes)"
    else
        s += "\nNo completed sessions yet"
    s

prune(KZone z) =>
    while array.size(z.boxes) > kzMaxDays
        box.delete(array.pop(z.boxes))
    while array.size(z.hiLines) > kzMaxDays
        line.delete(array.pop(z.hiLines))
        line.delete(array.pop(z.loLines))
    while array.size(z.hiLabels) > kzMaxDays
        label.delete(array.pop(z.hiLabels))
        label.delete(array.pop(z.loLabels))

tickZone(KZone z, bool use, bool inSess, bool newSess) =>
    if use and kzVisible
        solid = color.new(z.col, 0)

        if newSess
            // Resolve the session that just ended before starting a new one,
            // so the hit-rate denominator only counts finished sessions.
            if z.started
                z.nSessions := z.nSessions + 1
                if z.hiTaken
                    z.hiHits := z.hiHits + 1
                if z.loTaken
                    z.loHits := z.loHits + 1
            z.started  := true
            z.hiTaken  := false
            z.loTaken  := false
            z.hiOpen   := true
            z.loOpen   := true

            array.unshift(z.boxes, box.new(time, high, time, low, xloc = xloc.bar_time,
                 border_color = showKzBoxes ? z.col : na, bgcolor = showKzBoxes ? z.col : na))

            if showKzPivots
                array.unshift(z.hiLines, line.new(time, high, time, high, xloc = xloc.bar_time, color = solid, width = 1))
                array.unshift(z.loLines, line.new(time, low,  time, low,  xloc = xloc.bar_time, color = solid, width = 1))
                if showKzLabels
                    array.unshift(z.hiLabels, label.new(time, high, z.name + " H", xloc = xloc.bar_time,
                         style = label.style_label_left, color = #ffffff00, textcolor = solid, size = size.tiny,
                         tooltip = hitRateText(z.name, "high", high, z.hiHits, z.nSessions)))
                    array.unshift(z.loLabels, label.new(time, low, z.name + " L", xloc = xloc.bar_time,
                         style = label.style_label_left, color = #ffffff00, textcolor = solid, size = size.tiny,
                         tooltip = hitRateText(z.name, "low", low, z.loHits, z.nSessions)))
            prune(z)

        // Inside the session: grow the box and track the running high/low.
        if inSess and array.size(z.boxes) > 0
            b = array.get(z.boxes, 0)
            box.set_right(b, time)
            box.set_top(b, math.max(box.get_top(b), high))
            box.set_bottom(b, math.min(box.get_bottom(b), low))

            if showKzPivots and array.size(z.hiLines) > 0
                hl = array.get(z.hiLines, 0)
                ll = array.get(z.loLines, 0)
                line.set_x2(hl, time)
                line.set_x2(ll, time)
                if high > line.get_y1(hl)
                    line.set_xy1(hl, line.get_x1(hl), high)
                    line.set_xy2(hl, time, high)
                    if showKzLabels and array.size(z.hiLabels) > 0
                        label.set_xy(array.get(z.hiLabels, 0), time, high)
                        label.set_tooltip(array.get(z.hiLabels, 0), hitRateText(z.name, "high", high, z.hiHits, z.nSessions))
                if low < line.get_y1(ll)
                    line.set_xy1(ll, line.get_x1(ll), low)
                    line.set_xy2(ll, time, low)
                    if showKzLabels and array.size(z.loLabels) > 0
                        label.set_xy(array.get(z.loLabels, 0), time, low)
                        label.set_tooltip(array.get(z.loLabels, 0), hitRateText(z.name, "low", low, z.loHits, z.nSessions))

        // After the session: extend the pivots until price trades through them.
        if not inSess and showKzPivots and array.size(z.hiLines) > 0
            hl = array.get(z.hiLines, 0)
            ll = array.get(z.loLines, 0)
            if z.hiOpen
                line.set_x2(hl, time)
                if showKzLabels and array.size(z.hiLabels) > 0
                    label.set_x(array.get(z.hiLabels, 0), time)
                if high > line.get_y1(hl)
                    z.hiOpen  := false
                    z.hiTaken := true
            if z.loOpen
                line.set_x2(ll, time)
                if showKzLabels and array.size(z.loLabels) > 0
                    label.set_x(array.get(z.loLabels, 0), time)
                if low < line.get_y1(ll)
                    z.loOpen  := false
                    z.loTaken := true

inAsia  = not na(time(timeframe.period, asiaSess, kzTz))
inLdn   = not na(time(timeframe.period, ldnSess,  kzTz))
inNyAm  = not na(time(timeframe.period, nyAmSess, kzTz))
inNyPm  = not na(time(timeframe.period, nyPmSess, kzTz))

tickZone(zAsia, useAsia, inAsia, inAsia and not inAsia[1])
tickZone(zLdn,  useLdn,  inLdn,  inLdn  and not inLdn[1])
tickZone(zNyAm, useNyAm, inNyAm, inNyAm and not inNyAm[1])
tickZone(zNyPm, useNyPm, inNyPm, inNyPm and not inNyPm[1])

// =============================================================================
// Previous day / week / month levels
// Plotted rather than drawn as line objects: a stepped plot costs no drawing
// budget, which matters because the killzone boxes/lines already consume it.
// `high[1]` with lookahead_on is the standard non-repainting idiom for "the
// previous completed period's value".
// =============================================================================
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid, "W", low[1],  lookahead = barmerge.lookahead_on)
pmh = request.security(syminfo.tickerid, "M", high[1], lookahead = barmerge.lookahead_on)
pml = request.security(syminfo.tickerid, "M", low[1],  lookahead = barmerge.lookahead_on)

plot(showPD  ? pdh : na, "PDH", color = pdCol, style = plot.style_stepline)
plot(showPD  ? pdl : na, "PDL", color = pdCol, style = plot.style_stepline)
plot(showPDM and showPD ? math.avg(pdh, pdl) : na, "PDM", color = color.new(pdCol, 45), style = plot.style_stepline)

plot(showPW  ? pwh : na, "PWH", color = pwCol, style = plot.style_stepline, linewidth = 2)
plot(showPW  ? pwl : na, "PWL", color = pwCol, style = plot.style_stepline, linewidth = 2)
plot(showPWM and showPW ? math.avg(pwh, pwl) : na, "PWM", color = color.new(pwCol, 45), style = plot.style_stepline)

plot(showPM  ? pmh : na, "PMH", color = pmCol, style = plot.style_stepline, linewidth = 2)
plot(showPM  ? pml : na, "PML", color = pmCol, style = plot.style_stepline, linewidth = 2)
plot(showPMM and showPM ? math.avg(pmh, pml) : na, "PMM", color = color.new(pmCol, 45), style = plot.style_stepline)

// Name the levels once, at the right edge.
var label lPdh = na, var label lPdl = na, var label lPdm = na
var label lPwh = na, var label lPwl = na, var label lPwm = na
var label lPmh = na, var label lPml = na, var label lPmm = na

edgeLabel(label lb, bool use, float px, string txt, color c) =>
    label.delete(lb)
    label out = na
    if use and not na(px)
        out := label.new(bar_index + 2, px, txt, style = label.style_label_left,
             color = #ffffff00, textcolor = c, size = size.tiny)
    out

if barstate.islast
    lPdh := edgeLabel(lPdh, showPD, pdh, "PDH", pdCol)
    lPdl := edgeLabel(lPdl, showPD, pdl, "PDL", pdCol)
    lPdm := edgeLabel(lPdm, showPD and showPDM, math.avg(pdh, pdl), "PDM", pdCol)
    lPwh := edgeLabel(lPwh, showPW, pwh, "PWH", pwCol)
    lPwl := edgeLabel(lPwl, showPW, pwl, "PWL", pwCol)
    lPwm := edgeLabel(lPwm, showPW and showPWM, math.avg(pwh, pwl), "PWM", pwCol)
    lPmh := edgeLabel(lPmh, showPM, pmh, "PMH", pmCol)
    lPml := edgeLabel(lPml, showPM, pml, "PML", pmCol)
    lPmm := edgeLabel(lPmm, showPM and showPMM, math.avg(pmh, pml), "PMM", pmCol)

// =============================================================================
// Multi-timeframe bias + structure table
//
// Reads the SAME swing/displacement rules as the entry logic, but on higher
// timeframes via request.security, so the table can't disagree with the chart
// for methodological reasons. Every cell is a description of what already
// happened -- no cell predicts anything, and rows agreeing is a description
// of the chart, not evidence about the next move.
// =============================================================================
grpMTF = "Multi-timeframe table"
showMtf   = input.bool(true, "Show bias / structure table", group = grpMTF)
mtfPos    = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = grpMTF)
mtfTf1    = input.timeframe("W",   "Bias TF 1", group = grpMTF)
mtfTf2    = input.timeframe("D",   "Bias TF 2", group = grpMTF)
mtfTf3    = input.timeframe("240", "Structure TF 1", group = grpMTF)
mtfTf4    = input.timeframe("15",  "Structure TF 2", group = grpMTF)
mtfTf5    = input.timeframe("1",   "Structure TF 3", group = grpMTF)

mtfTablePos = mtfPos == "Top right" ? position.top_right : mtfPos == "Top left" ? position.top_left :
     mtfPos == "Bottom right" ? position.bottom_right : mtfPos == "Bottom left" ? position.bottom_left :
     position.middle_right

// --- Directional bias: where price closed relative to the PREVIOUS completed
// period's range, plus whether that period's liquidity was taken. This is the
// "swept W low / close < prev D low" read, computed rather than eyeballed.
biasFor(string tf) =>
    ph = request.security(syminfo.tickerid, tf, high[1], lookahead = barmerge.lookahead_on)
    pl = request.security(syminfo.tickerid, tf, low[1],  lookahead = barmerge.lookahead_on)
    ch = request.security(syminfo.tickerid, tf, high,    lookahead = barmerge.lookahead_on)
    cl = request.security(syminfo.tickerid, tf, low,     lookahead = barmerge.lookahead_on)
    cc = request.security(syminfo.tickerid, tf, close,   lookahead = barmerge.lookahead_on)

    string dir = "n/a"
    string ctx = "no data"
    if not (na(ph) or na(pl) or na(cc))
        sweptLow  = cl < pl
        sweptHigh = ch > ph
        if cc < pl
            dir := "Bearish"
            ctx := "Close < prev " + tf + " low"
        else if cc > ph
            dir := "Bullish"
            ctx := "Close > prev " + tf + " high"
        else if sweptLow and cc > pl
            dir := "Bullish"
            ctx := "Swept " + tf + " low, reclaimed"
        else if sweptHigh and cc < ph
            dir := "Bearish"
            ctx := "Swept " + tf + " high, rejected"
        else
            dir := "Neutral"
            ctx := "Inside prev " + tf + " range"
    [dir, ctx]

// --- Market structure: the same swing-break logic the strategy uses, plus a
// stage label describing what price is doing relative to the last break.
structFor(string tf) =>
    sh = request.security(syminfo.tickerid, tf, ta.pivothigh(high, swingLookback, swingLookback), lookahead = barmerge.lookahead_on)
    sl = request.security(syminfo.tickerid, tf, ta.pivotlow(low, swingLookback, swingLookback),   lookahead = barmerge.lookahead_on)
    cc = request.security(syminfo.tickerid, tf, close, lookahead = barmerge.lookahead_on)
    at = request.security(syminfo.tickerid, tf, ta.atr(atrLength), lookahead = barmerge.lookahead_on)
    bd = request.security(syminfo.tickerid, tf, math.abs(close - open), lookahead = barmerge.lookahead_on)

    var float hiRef = na
    var float loRef = na
    var string lastDir = "n/a"
    var int barsSince = 0

    if not na(sh)
        hiRef := sh
    if not na(sl)
        loRef := sl

    string stage = "Ranging"
    if not (na(hiRef) or na(loRef) or na(cc))
        broke = cc > hiRef or cc < loRef
        newDir = cc > hiRef ? "Bullish" : cc < loRef ? "Bearish" : lastDir
        if broke and newDir != lastDir
            lastDir := newDir
            barsSince := 0
        else
            barsSince := barsSince + 1

        displaced = not na(at) and not na(bd) and bd >= at * minDispATRMult
        stage := lastDir == "n/a" ? "Ranging" :
             barsSince <= 1 ? "Confirmed shift" :
             displaced ? "Expansion" : "Continuation"
    [lastDir, stage]

[b1d, b1c] = biasFor(mtfTf1)
[b2d, b2c] = biasFor(mtfTf2)
[s3d, s3s] = structFor(mtfTf3)
[s4d, s4s] = structFor(mtfTf4)
[s5d, s5s] = structFor(mtfTf5)

dirColor(string d) =>
    d == "Bullish" ? color.new(color.green, 0) : d == "Bearish" ? color.new(color.red, 0) : color.new(color.gray, 0)

var table mtfTable = table.new(mtfTablePos, 3, 9, border_width = 1, frame_width = 1)

mtfRow(table t, int row, string tf, string dir, string ctx) =>
    table.cell(t, 0, row, tf,  text_size = size.tiny, text_color = chart.fg_color)
    table.cell(t, 1, row, dir, text_size = size.tiny, text_color = dirColor(dir))
    table.cell(t, 2, row, ctx, text_size = size.tiny, text_color = chart.fg_color)

if barstate.islast and showMtf
    hdr = color.new(color.gray, 70)
    table.cell(mtfTable, 0, 0, "DIRECTIONAL BIAS", text_size = size.tiny, text_color = chart.fg_color, bgcolor = hdr)
    table.cell(mtfTable, 1, 0, "", bgcolor = hdr)
    table.cell(mtfTable, 2, 0, "", bgcolor = hdr)
    table.cell(mtfTable, 0, 1, "TF",        text_size = size.tiny, text_color = color.gray)
    table.cell(mtfTable, 1, 1, "Direction", text_size = size.tiny, text_color = color.gray)
    table.cell(mtfTable, 2, 1, "Context",   text_size = size.tiny, text_color = color.gray)
    mtfRow(mtfTable, 2, mtfTf1, b1d, b1c)
    mtfRow(mtfTable, 3, mtfTf2, b2d, b2c)

    table.cell(mtfTable, 0, 4, "MARKET STRUCTURE", text_size = size.tiny, text_color = chart.fg_color, bgcolor = hdr)
    table.cell(mtfTable, 1, 4, "", bgcolor = hdr)
    table.cell(mtfTable, 2, 4, "", bgcolor = hdr)
    table.cell(mtfTable, 0, 5, "TF",        text_size = size.tiny, text_color = color.gray)
    table.cell(mtfTable, 1, 5, "Direction", text_size = size.tiny, text_color = color.gray)
    table.cell(mtfTable, 2, 5, "Stage",     text_size = size.tiny, text_color = color.gray)
    mtfRow(mtfTable, 6, mtfTf3, s3d, s3s)
    mtfRow(mtfTable, 7, mtfTf4, s4d, s4s)
    mtfRow(mtfTable, 8, mtfTf5, s5d, s5s)

// =============================================================================
// Out-of-sample split
// =============================================================================
bgcolor(useOosSplit and time >= oosStart ? color.new(color.orange, 94) : na, title = "Out-of-sample period")

// Bottom-right, because the multi-timeframe table defaults to top-right and
// two tables sharing a corner overlap rather than stack.
var table oosTable = table.new(position.bottom_right, 3, 4, border_width = 1)

if barstate.islast and useOosSplit
    int isTrades = 0
    int oosTrades = 0
    float isWins = 0.0
    float oosWins = 0.0
    float isProfit = 0.0
    float isLoss = 0.0
    float oosProfit = 0.0
    float oosLoss = 0.0

    for i = 0 to strategy.closedtrades - 1
        entryTime = strategy.closedtrades.entry_time(i)
        pnl = strategy.closedtrades.profit(i)
        if entryTime >= oosStart
            oosTrades += 1
            if pnl > 0
                oosWins += 1
                oosProfit += pnl
            else
                oosLoss += -pnl
        else
            isTrades += 1
            if pnl > 0
                isWins += 1
                isProfit += pnl
            else
                isLoss += -pnl

    headerBg = color.new(color.gray, 70)
    table.cell(oosTable, 0, 0, "", bgcolor = headerBg)
    table.cell(oosTable, 1, 0, "In-sample", text_color = color.white, bgcolor = headerBg)
    table.cell(oosTable, 2, 0, "Out-of-sample", text_color = color.orange, bgcolor = headerBg)

    table.cell(oosTable, 0, 1, "Trades")
    table.cell(oosTable, 1, 1, str.tostring(isTrades))
    table.cell(oosTable, 2, 1, str.tostring(oosTrades))

    table.cell(oosTable, 0, 2, "Win rate")
    table.cell(oosTable, 1, 2, isTrades > 0 ? str.tostring(isWins / isTrades * 100, "#.#") + "%" : "n/a")
    table.cell(oosTable, 2, 2, oosTrades > 0 ? str.tostring(oosWins / oosTrades * 100, "#.#") + "%" : "n/a")

    table.cell(oosTable, 0, 3, "Profit factor")
    table.cell(oosTable, 1, 3, isLoss > 0 ? str.tostring(isProfit / isLoss, "#.##") : (isProfit > 0 ? "inf" : "n/a"))
    table.cell(oosTable, 2, 3, oosLoss > 0 ? str.tostring(oosProfit / oosLoss, "#.##") : (oosProfit > 0 ? "inf" : "n/a"))
