# Capital.com Credentials (Real Account)
CAPITAL_API_KEY=your_api_key_here
CAPITAL_EMAIL=your_email_here
CAPITAL_PASSWORD=your_password_here
CAPITAL_ACCOUNT_ID=your_account_id_here
CAPITAL_IS_DEMO=true

# MetaTrader 5 Settings (Funded Account)
# Leave MT5_LOGIN blank to automatically use the currently logged-in account in the MT5 app.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# AI Assistant (Stage 15C) — server-side only, never exposed to the browser.
# Optional: if unset, the AI Assistant page shows a "not configured" state and
# every other feature works normally.
GEMINI_API_KEY=
# gemini-1.5-flash is retired; use a current model. gemini-flash-lite-latest is
# fast + cheap. gemini-3.x "flash" reasoning models can be slow with context.
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_TIMEOUT_SEC=30
# GEMINI_MAX_OUTPUT_TOKENS=800

# Macro data provider (Phase 65) — server-side only.
#   unset / seed_demo : realistic seeded demo data (default). Never real.
#   fred              : real data from FRED/ALFRED (Federal Reserve).
#   none              : every macro response is unavailable.
# FRED coverage: CPI / core CPI / PCE / unemployment / policy rate / GDP /
# 2Y+10Y yields for USD/EUR/GBP/JPY/CAD/AUD/NZD/CHF. FRED has NO consensus
# forecast (surprise = n/a for FRED indicators), NO CFTC COT, NO ISM PMI.
# MACRO_DATA_PROVIDER=fred
# FRED_API_KEY=            # free, instant: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_CACHE_TTL_SEC=21600 # 6h — economic data updates slowly
# FRED_TIMEOUT_SEC=15
# FRED_HISTORY_START=2018-01-01

# Multi-provider macro evidence layer (Phase 66) — server-side only. Additive:
# each provider fills one capability; an unconfigured one leaves its category
# INSUFFICIENT_EVIDENCE (never a fabricated number). Read /api/macro/providers
# for the live coverage matrix + provider health.
#
#   COT positioning — CFTC Commitments of Traders. Official US gov, free, NO KEY.
#     Net non-commercial for GOLD(USD) / EUR / GBP / JPY / CAD / CHF / AUD / NZD.
#     Published Fri 15:30 ET; lookahead uses a conservative Fri-20:30-UTC release.
# MACRO_COT_PROVIDER=cftc
# CFTC_CACHE_TTL_SEC=21600
# CFTC_TIMEOUT_SEC=12
# CFTC_HISTORY_WEEKS=12
#
#   Consensus forecast — NO free authoritative source exists (Trading Economics /
#     Investing.com are paid / ToS-restricted). Default is unconfigured, so
#     surprise = actual - forecast stays UNAVAILABLE and is never fabricated.
#     Wire a provider in api/providers/forecast_provider.py, then set:
# MACRO_FORECAST_PROVIDER=none
#
#   Retail sentiment — no free redistributable feed (OANDA/IG gated). Default
#     unconfigured -> Sentiment category = INSUFFICIENT_EVIDENCE.
# MACRO_SENTIMENT_PROVIDER=none
