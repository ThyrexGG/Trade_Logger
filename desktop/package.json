{
  "name": "tradelogger-desktop",
  "productName": "TradeLogger",
  "version": "1.1.0",
  "description": "Desktop shell for TradeLogger — opens the live site in its own window, lives in the system tray, and alerts you natively if the backend goes down.",
  "author": "TradeLogger",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "site.tradelogger.desktop",
    "productName": "TradeLogger",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/icon.ico",
      "build/overlay-badge.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@44.4.1": true
  }
}
