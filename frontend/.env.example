# TradeLogger frontend environment configuration.
# Copy to `.env.local` (git-ignored) to override locally. NEVER put secrets here —
# every VITE_* value is embedded into the public client bundle.

# Base URL prepended to API requests.
# Leave EMPTY for local development: the Vite dev server proxies /api/* to FastAPI.
# Set to an absolute origin (e.g. https://api.example.com) only for hosted builds.
# When set, the API server must also list this app's origin in TL_ALLOWED_ORIGINS
# so the session cookie is accepted cross-origin.
VITE_API_BASE_URL=

# Dev-only: FastAPI target the Vite proxy forwards /api/* to.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8010

# Sentry DSN for browser error monitoring (optional). Leave empty to disable —
# this is a public key, safe to embed in the client bundle, but still only set
# it on the hosted build; no need for it in local dev.
# VITE_SENTRY_DSN=
