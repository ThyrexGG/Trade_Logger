# Production build (committed). Baked into the public JS bundle at build time —
# these are public values, not secrets. The API must list this app's origin
# in TL_ALLOWED_ORIGINS for the session cookie to work.
VITE_API_BASE_URL=https://tradelogger-api.onrender.com

# --- Auth mode (platform plan W10) ---------------------------------------
# 'multiuser' = invite-only email + password sign-in (identity is first-party;
# the backend needs TL_AUTH_MODE=multiuser + TL_SIGNUP_ALLOWLIST + TL_OWNER_EMAIL).
# Anything else / unset = the single-user passphrase gate.
VITE_AUTH_MODE=multiuser

# --- App tier ---------------------------------------------------------------
# 'friends' hides the research/strategy lab, forward-evidence/governance,
# command center, trade setup, market, risk gateway, AI assistant, audit and
# system-health pages from the sidebar and routes — only Journal, Analytics,
# Positions, Price Alerts and Connections remain. Same backend, same DB;
# local dev (.env.development / .env.local) doesn't set this, so `npm run
# dev` always shows the full app. See frontend/src/lib/navigation.ts.
VITE_APP_TIER=friends
