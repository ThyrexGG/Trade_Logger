# Production build (committed). Baked into the public JS bundle at build time —
# these are public values, not secrets. The API must list this app's origin
# in TL_ALLOWED_ORIGINS for the session cookie to work.
VITE_API_BASE_URL=https://tradelogger-api.onrender.com

# --- Multi-user auth (platform plan W8) ------------------------------------
# Leave VITE_AUTH_MODE unset for the single-user passphrase gate. Set it to
# 'supabase' AND fill both values below to switch on invite-only multi-user
# sign-in. The anon key is safe in the public bundle (access is gated by the
# backend allowlist). Never put the service-role key or JWT secret here.
VITE_AUTH_MODE=supabase
VITE_SUPABASE_URL=https://wutzxzophrfkqpylcswc.supabase.co
