# Local credentials and database
# Ignore every .env variant (.env, .env.local, .env.bak, .env.fred, .env.2, …)
.env
.env.*
# …but keep the checked-in templates
!.env.example
!.env.sample
!.env.template

# Other secret-bearing files — never commit
*.pem
*.key
*.p12
*.pfx
*_rsa
*_ed25519
id_rsa*
secrets.json
secrets.yaml
secrets.yml
.secrets
credentials.json
service-account*.json
*.env.enc

*.db

# Temporary test and migration scripts in root
/test_*.py
/debug_*.py
/check_*.py
/find_*.py
/reset_*.py
/migrate_*.py
/generate_*.py

# Keep test suite
!tests/
!tests/**

# Python caches
__pycache__/
*.py[cod]
*$py.class

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Claude Code — personal per-machine overrides (settings.json is shared)
.claude/settings.local.json

# runtime logs (auto_sync daemon etc.)
sync_log.txt

# Stray local Python install-manager artifacts (PEP 514 / py manager) — not project files
/Python/
python_install_*.log
