{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s http://127.0.0.1:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git clean -f*)",
      "Bash(git clean -x*)",
      "Bash(sudo *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(choco install*)",
      "Bash(winget install*)",
      "Bash(scoop install*)"
    ]
  }
}
